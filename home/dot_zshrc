# ── Platform ─────────────────────────────────────────────────────────────────
# Cached once; `uname` in a hot startup path is a fork we don't need to repeat.
_os="$(uname -s)"

# ── Terminal capability ──────────────────────────────────────────────────────
# No line editor, no interactive layer. That's the case whenever TERM is
# `dumb` (zsh force-disables the `zle` option outright) or stdin isn't a
# terminal — an editor's shell mode, a `zsh -ic` from a script, a coding agent
# shelling out. In those shells the prompt and key bindings aren't just
# useless, they're noisy: key-binding scripts fail restoring their saved options
# with `can't change option: zle`, printed ahead of the output the caller
# actually wanted.
#
# Everything below still runs: PATH, mise, completions, aliases, tool hooks.
# Only the interactive layer is skipped, keyed off this flag.
if [[ "$TERM" == dumb || ! -o interactive || ! -t 0 ]]; then
  _no_zle=1
  PS1='%# '
fi

# ── Homebrew (macOS) ─────────────────────────────────────────────────────────
# Non-login shells (and some terminals' defaults) don't always inherit /etc/paths.d,
# so brew-installed tools below would silently vanish. No-op if brew's already
# on PATH or isn't installed.
if [[ "$_os" == "Darwin" ]] && ! command -v brew >/dev/null 2>&1; then
  for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    if [ -x "$_brew" ]; then eval "$("$_brew" shellenv)"; break; fi
  done
  unset _brew
fi

# ── PATH ─────────────────────────────────────────────────────────────────────
# The base entries are set in zshenv, which every zsh reads — this repeats them
# because on macOS /etc/zprofile runs path_helper between zshenv and this file
# and reorders PATH so system directories come first. zshenv's `typeset -U path`
# is what keeps the repeat from duplicating: re-prepending an existing entry
# moves it back to the front instead of adding a second copy.
#
# Base entries first so ~/.zshrc.local (sourced below) can still prepend
# machine-specific paths that need to win.
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"

# uv drops an env script here; it extends PATH and nothing else.
[ -f "$HOME/.local/bin/env" ] && source "$HOME/.local/bin/env"

# ── Version manager (mise) ───────────────────────────────────────────────────
# Replaces asdf. One binary with no per-tool `plugin add`, and it activates by
# rewriting PATH on each prompt instead of installing shims — so a version
# change takes effect in the shell you're standing in, with no `reshim` step.
#
# Pins live in ~/.config/mise/config.toml, rendered from packages.yaml. mise
# walks parent directories to find config, so that file is the default for
# everything under $HOME while a project's own mise.toml still wins inside it.
command -v mise >/dev/null 2>&1 && eval "$(mise activate zsh)"

# ── Completion ──────────────────────────────────────────────────────────────
# fpath additions must land before compinit, and compinit must run before
# antidote loads plugins that hook into it. Tern's native completion also needs it:
# without `compinit` it leaves Tab alone.
#
# install.sh generates `_<cmd>` files here for tools whose completions no
# package manager provides — omp, tree-sitter — and for tools that only
# get them from Homebrew, so a Linux box ends up with the same coverage. It
# comes first on fpath deliberately: these files were generated by the exact
# binary that's installed, so they should win over a distro's stale copy.
fpath=("$HOME/.local/share/zsh/site-functions" $fpath)
autoload -Uz compinit
# -C trusts the existing dump instead of scanning fpath on every shell start,
# which is the difference between a ~15ms and a ~150ms startup. The tradeoff is
# that newly added completions are invisible until the dump is rebuilt, so
# install.sh deletes ~/.zcompdump* whenever it writes new ones.
compinit -C

# ── Plugin manager (antidote, replaces Oh My Zsh) ───────────────────────────
# install.sh clones it to ~/.antidote, but a machine that got it from Homebrew
# keeps it under the brew prefix. Take whichever exists; an unguarded source
# here would throw on every single shell start.
_antidote=""
for _c in "$HOME/.antidote/antidote.zsh" \
          "${HOMEBREW_PREFIX:-/opt/homebrew}/opt/antidote/share/antidote/antidote.zsh" \
          /usr/local/opt/antidote/share/antidote/antidote.zsh \
          /usr/share/zsh-antidote/antidote.zsh; do
  [ -f "$_c" ] && { _antidote="$_c"; break; }
done
if [ -n "$_antidote" ]; then
  source "$_antidote"
  antidote load "$HOME/.zsh_plugins.txt"
else
  # stderr, so a missing plugin manager is visible in an interactive shell
  # but never pollutes stdout captured from editor/automation shells. The
  # fix is one apply: chezmoi's .antidote external clones it.
  echo "zshrc: antidote not found — run \`chezmoi apply\` to set up plugins" >&2
fi
unset _antidote _c

# ── Carapace (multi-shell completion generator) ─────────────────────────────
# Its matches feed Tern's native completion list like any other zsh completion.
# No line editor, no point installing completion widgets — same reasoning as the
# key-binding guard below.
if [[ -z $_no_zle ]] && command -v carapace >/dev/null 2>&1; then
  # A bridge means: for a command carapace has no native spec for, fall back
  # to another shell's completion spec instead of giving you nothing. Order
  # is preference, first match wins.
  export CARAPACE_BRIDGES='zsh,fish,bash,inshellisense'
  source <(carapace _carapace)
fi
# carapace ships no spec for omp or tree-sitter — those are exactly
# the tools install.sh hand-generates `_omp`/`_tree-sitter` files
# for in the Completion section above. The two mechanisms cover disjoint
# sets of commands; don't delete the generator step as redundant with this.

# ── Machine-local secrets/overrides — never committed ───────────────────────
# See zshrc.local.example for the template. Sourced before the tool blocks
# below so it can set inputs they read (PNPM_HOME, build flags, …).
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"

# omp's own per-machine overlay is separate from the block above: chezmoi creates
# ~/.omp/agent/config.local.yml once on every machine (never committed), so a
# machine can add its own model presets, or override modelRoles, on
# top of the shared ~/.omp/agent/config.yml without editing it. Guard
# on existence rather than exporting unconditionally — PI_CONFIG_FILES
# pointing at a missing file is a hard error for omp, not a silent skip.
[ -f "$HOME/.omp/agent/config.local.yml" ] && export PI_CONFIG_FILES="$HOME/.omp/agent/config.local.yml"

# ── Editor ───────────────────────────────────────────────────────────────────
# nvim when it's installed, vim as the fallback. No $SSH_CONNECTION check: this
# file runs on whichever box the shell is on — including one you've SSH'd into —
# so probing for the binary already answers "does this machine have nvim?".
# `vim` is aliased alongside so muscle memory lands in the same editor.
if command -v nvim >/dev/null 2>&1; then
  export EDITOR='nvim'
  export VISUAL='nvim'
  alias vim='nvim'
else
  export EDITOR='vim'
  export VISUAL='vim'
fi

# ── History ──────────────────────────────────────────────────────────────────
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt EXTENDED_HISTORY       # store timestamps
setopt INC_APPEND_HISTORY     # write as commands run, not just on exit
setopt SHARE_HISTORY          # share across concurrent sessions
setopt HIST_IGNORE_ALL_DUPS   # drop older duplicates, not just adjacent ones
setopt HIST_IGNORE_SPACE      # leading space = don't record
setopt HIST_REDUCE_BLANKS     # normalize whitespace before storing
setopt HIST_VERIFY            # expand history into the buffer, don't run it blind

# ── Shell quality of life ────────────────────────────────────────────────────
setopt AUTO_CD                # typing a directory name cds into it
setopt EXTENDED_GLOB          # ~/^/# glob qualifiers

# ── Prompt / navigation ──────────────────────────────────────────────────────
# No prompt tool: Tern draws its own prompt (Settings → Prompt, any style but `imported`)
# over PS1. direnv is guarded inside its own init output and stays useful
# (per-directory env) in a scripted shell.
command -v direnv   >/dev/null 2>&1 && eval "$(direnv hook zsh)"

# ── Key bindings ─────────────────────────────────────────────────────────────
# Nothing on Ctrl+R while testing Tern without a shell history search; `-r` drops zsh's
# built-in search. zsh-vi-mode binds viins Ctrl+R back to that search during its init on the
# first precmd — after every line of this file — so the unbind reruns from
# zvm_after_init_commands, the plugin's supported hook for bindings that must outlive its
# keymap setup. vicmd keeps Ctrl+R as vi redo.
if [[ -z $_no_zle ]]; then
  _unbind_ctrl_r() { bindkey -M emacs -r '^R'; bindkey -M viins -r '^R' }
  _unbind_ctrl_r
  (( ${+zvm_after_init_commands} )) && zvm_after_init_commands+=(_unbind_ctrl_r)
fi

# ── Claude Code ──────────────────────────────────────────────────────────────
# `--dangerously-skip-permissions` is what makes the tool usable at all on a
# machine this trusted; typing it out every invocation is friction with no
# safety benefit here, so it's baked into the alias instead.
command -v claude >/dev/null 2>&1 && alias claude='claude --dangerously-skip-permissions'

# ── Node / pnpm / bun ────────────────────────────────────────────────────────
if [ -z "${PNPM_HOME:-}" ]; then
  case "$_os" in
    Darwin) PNPM_HOME="$HOME/Library/pnpm" ;;
    *)      PNPM_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/pnpm" ;;
  esac
fi
if [ -d "$PNPM_HOME" ]; then
  export PNPM_HOME
  case ":$PATH:" in *":$PNPM_HOME:"*) ;; *) export PATH="$PNPM_HOME:$PATH" ;; esac
else
  unset PNPM_HOME
fi

[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"
if [ -d "$HOME/.bun/bin" ]; then
  export BUN_INSTALL="$HOME/.bun"
  export PATH="$BUN_INSTALL/bin:$PATH"
fi

# ── Go ───────────────────────────────────────────────────────────────────────
# GOPATH default rather than `go env GOPATH` — that's a subprocess on every
# shell start for a value that's ~/go unless something already set it.
if command -v go >/dev/null 2>&1; then
  [ -n "${GOBIN:-}" ] && export PATH="$GOBIN:$PATH"
  export PATH="$PATH:${GOPATH:-$HOME/go}/bin"
fi

# ── Chrome for Testing ───────────────────────────────────────────────────────
# Puppeteer's browser download (packages.yaml) lands in a versioned, arch-named
# directory under ~/.cache/puppeteer with nothing on PATH, so the path changes
# on every `npx puppeteer browsers install`. Resolve the newest install at call
# time instead of hardcoding a version that goes stale. `(om[1])` = most recently
# modified match; `N` makes a miss expand to nothing instead of a zsh glob error.
# The launcher runs the executable directly, in the foreground, rather than
# through `open -na`: `open` detaches the process, so Ctrl-C wouldn't stop it and
# Chrome's stderr would vanish.
# These use $OSTYPE, not `$_os`: `_os` is unset at the end of this file, so it's
# empty by the time a function runs and every call would take the Linux branch.

# Resolves the executable (not the .app bundle) into $REPLY.
_cft_bin() {
  local -a m
  if [[ "$OSTYPE" == darwin* ]]; then
    m=("$HOME"/.cache/puppeteer/chrome/*/chrome-mac-*/"Google Chrome for Testing.app"/Contents/MacOS/"Google Chrome for Testing"(N.om[1]))
  else
    m=("$HOME"/.cache/puppeteer/chrome/*/chrome-linux64/chrome(N.om[1]))
  fi
  [[ -n "$m" ]] || { echo "cft: Chrome for Testing not installed (npx puppeteer browsers install chrome)" >&2; return 1; }
  REPLY="$m"
}

# Shared debugging flags. The profile lives outside Chrome's default one so
# logins made in a headed `cft` persist for `cft headless` (headless can't show a
# login page). --remote-allow-origins="*" is required since Chrome 111 or CDP
# websocket clients from a browser origin are rejected. The two --disable-*
# flags stop Chrome throttling tabs that are occluded/backgrounded, which
# otherwise stalls automation running while you work in another window.
# --disable-background-networking skips component-update/Safe Browsing pings a test
# browser doesn't need. It does NOT silence the harmless `DEPRECATED_ENDPOINT` GCM
# error at startup (CfT has no Google API keys); no flag tried removes that line.
# --window-size is the default for both modes: headless otherwise gets 800x600.
_cft_args=(
  --remote-debugging-port=9222
  --remote-allow-origins="*"
  --user-data-dir="$HOME/.cache/cft-profile"
  --no-first-run
  --no-default-browser-check
  --disable-backgrounding-occluded-windows
  --disable-renderer-backgrounding
  --disable-background-networking
  --window-size=1440,900
)

# cft            headed window: log in here to create auth sessions in the profile.
# cft headless   same config, no window: reuses the sessions saved by a headed run.
# Anything after the mode is passed through to Chrome (e.g. a URL).
cft() {
  local -a mode=()
  if [[ "$1" == headless ]]; then mode=(--headless=new); shift; fi
  _cft_bin || return 1

  # Chrome restores the previous window's bounds from two places in the profile and
  # either one beats --window-size: `browser.window_placement` in Preferences, and
  # the Sessions/ dir that session restore replays. A window resized once (or a run
  # that left a tiny one behind) would otherwise stay that size forever. Clearing
  # both while Chrome is not running makes the flag authoritative on every launch.
  # Cookies and logins live in their own files, so auth sessions survive this;
  # only the previous run's open tabs are not restored.
  local profile="$HOME/.cache/cft-profile/Default"
  rm -rf "$profile/Sessions"
  if [[ -f "$profile/Preferences" ]] && command -v jq >/dev/null 2>&1; then
    jq 'del(.browser.window_placement)' "$profile/Preferences" > "$profile/Preferences.tmp" &&
      mv "$profile/Preferences.tmp" "$profile/Preferences"
  fi

  "$REPLY" "${mode[@]}" "${_cft_args[@]}" "$@"
}

# ── macOS-only fixups ────────────────────────────────────────────────────────
if [[ "$_os" == "Darwin" ]]; then
  # Apple ships GNU make 3.81 (2006) as *both* `make` and `gnumake`, so the
  # obvious `alias make=gnumake` is a no-op. Homebrew's make installs as
  # `gmake` (4.x) to avoid the clash — that's the one worth reaching for.
  command -v gmake >/dev/null 2>&1 && alias make="gmake"
  alias disable-chrome-updater='sudo "/Library/Application Support/Google/GoogleUpdater/Current/GoogleUpdater.app/Contents/MacOS/GoogleUpdater" --uninstall --system'
fi

# ── Linux-only fixups ────────────────────────────────────────────────────────
if [[ "$_os" == "Linux" ]]; then
  # systemctl --user needs this set over SSH / non-login shells; harmless
  # no-op when a real login session already set it via pam_systemd.
  export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
fi

unset _os _no_zle
