{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
set -euo pipefail
{{ template "output.sh.tmpl" . }}
heading "Background services"

if command -v dstack >/dev/null 2>&1; then
  plist="$HOME/Library/LaunchAgents/ai.dstack.server.plist"
  if [ ! -e "$plist" ]; then
    skipped "dstack-server" "no LaunchAgent tracked"
  elif ! launchctl list ai.dstack.server >/dev/null 2>&1; then
    run_quiet "dstack-server" launchctl load -w "$plist" && added "dstack-server" "LaunchAgent loaded"
  else
    ok "dstack-server" "already loaded"
  fi
else
  skipped "dstack-server" "dstack not installed"
fi
{{ end -}}
