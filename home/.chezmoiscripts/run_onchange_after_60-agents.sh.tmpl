#!/usr/bin/env bash
set -euo pipefail
{{ template "output.sh.tmpl" . }}

# ── omp plugins ──────────────────────────────────────────────────────────
heading "omp plugins"
if command -v omp >/dev/null 2>&1; then
  count=0
{{ range $.packages -}}
{{-   $spec := or (index . $.chezmoi.os) (index . "all") }}
{{-   if $spec }}{{ if eq $spec.via "omp" }}
{{-     if index $spec "marketplace" }}
  # `marketplace add` errors when the marketplace is already registered, and
  # that must not abort the install below it (set -e) on every re-run.
  omp plugin marketplace add {{ index $spec "marketplace" | squote }} >/dev/null 2>&1 || true
{{-     end }}
  count=$((count + 1))
  run_quiet {{ .name | squote }} omp plugin install {{ (index $spec "id") | squote }} && updated {{ .name | squote }}
{{ end }}{{ end }}
{{- end }}
  [ "$count" -gt 0 ] || ok "omp plugins" "none configured yet"
else
  skipped "omp" "not on PATH — skipping omp plugins"
fi

# ── gh extensions ────────────────────────────────────────────────────────
heading "gh extensions"

# `gh extension install` and `gh extension upgrade` are different commands —
# neither upserts — so an already-installed extension has to be detected
# first.
if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
  :
{{ range $.packages -}}
{{-   $spec := or (index . $.chezmoi.os) (index . "all") }}
{{-   if $spec }}{{ if eq $spec.via "gh" }}
{{-     $id := (index $spec "id") | default .name }}
  if gh extension list 2>/dev/null | awk '{print $3}' | grep -qx {{ $id | squote }}; then
    run_quiet {{ $id | squote }} gh extension upgrade {{ $id | squote }} && updated {{ $id | squote }}
  else
    run_quiet {{ $id | squote }} gh extension install {{ $id | squote }} && added {{ $id | squote }}
  fi
{{ end }}{{ end }}
{{- end }}
else
  warned "gh" "not authenticated — skipping gh extensions"
fi

# ── cross-agent skills ───────────────────────────────────────────────────
heading "skills"

# `npx skills add` keeps one canonical copy of each skill in ~/.agents/skills
# and symlinks every agent it detects at that tree. Re-adding an installed
# skill is how the CLI updates one, so this runs every time. npx's own
# --yes skips its "need to install skills@x, ok to proceed?" prompt — the
# skills CLI's own -y is a separate flag for its own prompts.
{{ range $.packages -}}
{{-   $spec := or (index . $.chezmoi.os) (index . "all") }}
{{-   if $spec }}{{ if eq $spec.via "skill" }}
{{-     $skillName := trimPrefix "skill/" .name }}
run_quiet {{ .name | squote }} mise exec -- npx --yes skills add {{ (index $spec "id") | squote }} --skill {{ $skillName | squote }} -g -y && updated {{ .name | squote }}
{{ end }}{{ end }}
{{- end }}
