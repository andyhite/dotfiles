{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
set -euo pipefail
{{ template "output.sh.tmpl" . }}

# No Brewfile is tracked. Generating one at apply time from packages.yaml
# means nothing in $HOME can drift from the manifest or be hand-edited, and
# keeps this repo from ever writing $XDG_CONFIG_HOME/homebrew/Brewfile —
# `brew bundle --global` reads that exact path, and a chezmoi-managed file
# there would silently become the global Brewfile for every bare
# `brew bundle` invocation on the machine.
brewfile="$(mktemp)"
trap 'rm -f "$brewfile"' EXIT

cat >"$brewfile" <<'BREWFILE'
{{- range $.packages }}
{{-   $spec := or (index . $.chezmoi.os) (index . "all") }}
{{-   if $spec }}
{{-     if eq $spec.via "brew" }}
brew "{{ (index $spec "id") | default .name }}"
{{-     else if eq $spec.via "cask" }}
{{-       if index $spec "args" }}
cask "{{ (index $spec "id") | default .name }}", args: { {{ index $spec "args" }} }
{{-       else }}
cask "{{ (index $spec "id") | default .name }}"
{{-       end }}
{{-     end }}
{{-   end }}
{{- end }}
BREWFILE

if brew bundle check --file "$brewfile" >/dev/null 2>&1; then
  ok "homebrew" "up to date"
else
  # `brew bundle check --verbose` reports each outstanding formula/cask as
  # "→ Formula/Cask <name> needs to be installed or updated." — pull just the
  # names out so this prints one readable line instead of the raw report.
  report="$(brew bundle check --file "$brewfile" --verbose 2>&1 || true)"
  missing="$(sed -n 's/^→ [A-Za-z]* \(.*\) needs to be installed or updated\./\1/p' \
    <<<"$report" | paste -sd' ' - || true)"
  if [ -n "$missing" ]; then
    say "installing/upgrading: $missing"
  fi
  say "1password-cli's signed .pkg may prompt for your sudo password mid-run"
  if run_quiet "homebrew" brew bundle install --file "$brewfile" --quiet; then
    updated "homebrew" "${missing:-formulae and casks}"
  fi
fi
{{ end -}}
