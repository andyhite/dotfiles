#!/usr/bin/env bash
set -euo pipefail
{{ template "output.sh.tmpl" . }}
heading "mise (bootstrap)"

# mise cannot install itself from its own config, so its `packages.yaml`
# entry is read directly here rather than filtered like every other tool.
# Once present, mise is upgraded by whichever manager installed it — this
# only ever handles the from-nothing case.
if command -v mise >/dev/null 2>&1; then
  exit 0
fi

{{ if eq .chezmoi.os "darwin" -}}
run_quiet mise brew install mise && added mise
{{- else -}}
run_quiet mise sh -c "curl -sS https://mise.run | sh" && added mise
{{- end }}
