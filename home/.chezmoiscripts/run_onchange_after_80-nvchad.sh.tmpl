#!/usr/bin/env bash
set -euo pipefail
{{ template "output.sh.tmpl" . }}
heading "NvChad restore"

# chezmoi's `include` resolves relative to the source dir and cannot reach
# linked/, so this can't self-hash the lockfile at render time — hash it at
# runtime instead, against the state this script itself last wrote, and skip
# the restore when nothing changed.
command -v nvim >/dev/null 2>&1 || exit 0

lockfile="{{ .chezmoi.workingTree }}/linked/nvim/lazy-lock.json"
statedir="$HOME/.local/state/dotfiles"
statefile="$statedir/nvchad-lock.sha256"
mkdir -p "$statedir"

hash="$(shasum -a 256 "$lockfile" 2>/dev/null | awk '{print $1}')"
if [ -f "$statefile" ] && [ "$(cat "$statefile")" = "$hash" ]; then
  ok "nvchad plugins" "up to date"
  exit 0
fi

# The retry policy is deliberate: on failure the hash stays unwritten and the
# apply carries on with a warning — a transient plugin/network failure should
# not fail the whole apply, and every later `chezmoi apply` reattempts the
# restore until one succeeds and records the hash. A restore that keeps
# failing therefore keeps warning, which is the signal to run
# `nvim "+Lazy! restore"` interactively and read the real error.
if run_quiet "nvchad plugins" nvim --headless "+Lazy! restore" +qa; then
  updated "nvchad plugins" "restored"
  printf '%s' "$hash" >"$statefile"
else
  warned "nvchad plugins" "restore failed — retrying on the next apply"
fi
