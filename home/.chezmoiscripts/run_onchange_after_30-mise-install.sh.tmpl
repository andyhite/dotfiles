#!/usr/bin/env bash
set -euo pipefail
{{ template "output.sh.tmpl" . }}
heading "mise tools"

# Backend runtimes first, not redundant with the bare `mise install --yes`
# below: mise does not promise to order npm:/cargo: tools after the runtimes
# they shell out to, so anything resolved through those backends needs its
# runtime on PATH before it can build. The list is derived from
# packages.yaml — an npm: entry pulls in node, a cargo: entry pulls in
# rust — so adding or removing a backend tool in the manifest is the only
# edit; nothing here names a tool by hand.
{{- $runtimes := list }}
{{- range $.packages }}
{{-   $spec := or (index . $.chezmoi.os) (index . "all") }}
{{-   if and $spec (eq $spec.via "mise") }}
{{-     $id := (index $spec "id") | default .name }}
{{-     if hasPrefix "npm:" $id }}{{ $runtimes = append $runtimes "node" }}{{ end }}
{{-     if hasPrefix "cargo:" $id }}{{ $runtimes = append $runtimes "rust" }}{{ end }}
{{-   end }}
{{- end }}
{{- $runtimes = $runtimes | uniq }}
{{- if $runtimes }}
run_quiet "mise ({{ $runtimes | join ", " }})" mise install --yes {{ $runtimes | join " " }}
{{- end }}
run_quiet "mise (all tools)" mise install --yes

# One status line per tool, reusing mise's own installed-version report
# instead of tracking added/updated ourselves — `mise install` above already
# no-ops for anything current, so this is just visibility, not extra work.
while read -r tool version _; do
  [ -n "$tool" ] || continue
  ok "$tool" "$version"
done < <(mise ls --current --quiet 2>/dev/null)

# Rendered tool list, embedded so this script's own content — and therefore
# chezmoi's onchange trigger — changes whenever packages.yaml's mise entries
# do, even though the commands above never mention a tool by name.
#
