# Git config — tracked identity, LFS/xet wiring, and defaults that hold on
# every machine. Anything that varies per machine (work identity, private
# registry credentials, credential rewrites) belongs in ~/.gitconfig.local,
# pulled in by the [include] at the bottom — never in this file.

[user]
	name = Andrew Hite
	email = andy@andyhite.com
[init]
	defaultBranch = main

# ── Git LFS / xet ────────────────────────────────────────────────────────────
# git-lfs writes this filter into every repo's local config too, but it also
# has to exist globally for `git clone`/`git lfs clone` to hydrate LFS files
# in a repo before that repo's own hooks have run.
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
# git-xet is a Git LFS custom transfer agent — faster than LFS's default HTTP
# transfer for repos that opt into it via their own .lfsconfig.
[lfs "customtransfer.xet"]
	path = git-xet
	args = transfer
	concurrent = true

# ── Credentials ──────────────────────────────────────────────────────────────
# https auth for github.com/gist.github.com goes through gh's own credential
# helper instead of a stored token. This block used to sit next to a
# `[url "https://<token>@github.com/"] insteadOf = https://github.com/`
# rewrite that put a long-lived PAT in plaintext in this file — dropping it is
# a strict improvement, since the helpers below already cover https auth
# without ever writing a token to disk.
# `gh` is resolved from PATH here, not the Homebrew-prefix absolute path
# `gh`'s own installer used to bake in on this machine — this file also needs
# to work on Linux, where that prefix doesn't exist.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

# ── Quality-of-life defaults ─────────────────────────────────────────────────
# core.excludesFile is deliberately unset: git already reads
# $XDG_CONFIG_HOME/git/ignore by default when the variable isn't set, and
# that's exactly config/git/ignore, symlinked to ~/.config/git/ignore. Setting
# it here would just be a second, redundant place for that path to drift out
# of sync with install.sh's symlink.
[push]
	# First push of a new branch creates its upstream automatically — no more
	# `git push -u origin <branch>` on every new branch.
	autoSetupRemote = true
	# `git push` also pushes annotated tags reachable from what's pushed,
	# without needing `--follow-tags` spelled out every time.
	followTags = true
[pull]
	# `git pull` rebases local commits onto upstream instead of merging, to
	# match the rebase-oriented settings below and keep history linear.
	rebase = true
[rebase]
	# Stashes a dirty worktree before an interactive rebase and pops it after,
	# instead of refusing to start.
	autoStash = true
	# Honors `fixup!`/`squash!` commit-message prefixes automatically during
	# `git rebase -i`, no `--autosquash` flag needed.
	autoSquash = true
	# Moves dependent branch refs along with the commits they point at when
	# rebasing a stack (git 2.38+), instead of leaving them pointing at the
	# old, now-abandoned commits.
	updateRefs = true
[fetch]
	# Deletes local remote-tracking branches whose upstream branch was
	# deleted, instead of letting stale refs pile up forever.
	prune = true
	# Same, for tags whose upstream tag was deleted or moved. Only takes
	# effect because fetch.prune is also on.
	pruneTags = true
[merge]
	# zdiff3 conflict markers also show the common ancestor's version of the
	# conflicting region, not just "ours" and "theirs" like the default "merge"
	# style — so you can see what each side actually changed instead of
	# guessing. Needs git 2.35+. Pairs with the rerere settings below: rerere
	# replays how a matching conflict resolved before, and zdiff3 gives the
	# ancestor context to sanity-check a conflict shaped just differently enough
	# that rerere doesn't recognize it.
	conflictStyle = zdiff3
[diff]
	# Produces more readable hunks than the default myers algorithm,
	# especially across reordered code.
	algorithm = histogram
	# Highlights moved lines as moved rather than as a delete+add pair, so a
	# refactor doesn't read like a wholesale rewrite.
	colorMoved = default
	# Replaces the a/ b/ diff prefixes with mnemonic i/ (index) o/ (old)
	# w/ (worktree) c/ (commit) — easier to tell which side of a diff you're
	# looking at.
	mnemonicPrefix = true
	# Detects copies in addition to renames (the default only looks for
	# renames), catching copy-then-modify patterns too.
	renames = copies
[rerere]
	# Records how a conflict was resolved so an identical conflict
	# auto-resolves next time — mainly useful when rebasing the same branch
	# over the same base repeatedly.
	enabled = true
	# Stages rerere's auto-resolved result instead of leaving it unstaged to
	# `git add` by hand.
	autoupdate = true
[branch]
	# `git branch` lists the most recently committed-to branch first,
	# instead of alphabetically.
	sort = -committerdate
[tag]
	# `git tag` lists in semantic-version order (v9 before v10) instead of
	# lexicographic.
	sort = version:refname
[column]
	# Multi-column output for branch/tag/status listings when the terminal
	# is wide enough to use it.
	ui = auto
[commit]
	# Includes the diff being committed as a comment in the message editor
	# buffer, so you can see what you're describing while writing it.
	verbose = true
[help]
	# Offers to run the intended command on a typo'd subcommand instead of
	# just failing. "prompt" asks first; "immediate" would run it
	# unconfirmed.
	autocorrect = prompt
[core]
	# Perf: watches the filesystem for changes instead of stat-ing every
	# tracked file on every git operation. Needs git 2.37+ for the builtin
	# monitor — older git silently ignores this setting rather than erroring.
	fsmonitor = true
	# Perf: caches which directories have no untracked files between
	# operations, cutting status/diff time on large trees. Relies on
	# fsmonitor (or reliable mtimes) to know when to invalidate — both are
	# already satisfied above.
	untrackedCache = true

# ── Hunk (diff & log pager) ──────────────────────────────────────────────────
# Hunk renders diff/log/show in a review-first TUI — multi-file sidebar,
# split/stack layouts, and inline agent annotations — instead of a scrolling
# stream. Pager mode sniffs stdin: patch-like content opens the review UI,
# anything else (a bare `git log`, `git config --list`) streams to a plain-text
# pager instead, so this slot stays usable for non-diff output.
[core]
	# The `|| less` fallback is mandatory and is NOT redundant with hunk's own
	# plain-text fallback: that one picks a pager by CONTENT type, this one
	# covers a MISSING BINARY. git runs the value through `sh -c`, so an
	# unguarded `hunk pager` on a fresh machine (or one where the tools step was
	# declined) exits 127 and bricks every `git diff`/`log`/`show` on the very
	# box the bootstrap script is provisioning. Two words survive `sh -c` fine.
	#
	# Hunk resolves its own text pager from HUNK_TEXT_PAGER, then PAGER, then
	# `less -R`, and ignores a value that resolves back to hunk so git can never
	# recurse into `hunk pager` itself.
	pager = hunk pager || less
[interactive]
	# Delta, not hunk, and deliberately so: `add -p` parses this filter's output
	# and needs it to line up 1:1 with what git generated, so the filter has to
	# be a line-oriented stream editor. Hunk is a full-screen TUI with no
	# `--color-only` equivalent (it rejects the flag outright), so it cannot
	# fill this slot at all — this is one of exactly two places delta survives.
	# `--color-only` stops delta from reflowing hunks the way it does for a
	# plain diff view. Same sh -c fallback as core.pager above: `|| cat` keeps
	# add -p usable without delta installed instead of failing outright.
	diffFilter = delta --color-only || cat
# Delta's remaining blast radius is just the `add -p` filter above and
# lazygit's diff panel (config/lazygit/config.yml) — both places hunk provably
# cannot go. Everything here is scoped to those two surfaces; delta no longer
# renders an ordinary `git diff`.
[delta]
	# Shows line numbers in the gutter of each hunk instead of delta's default
	# of none, matching hunk's own `line_numbers = true`.
	line-numbers = true
	# There is no dark GitHub syntax theme in delta's bundle — `delta
	# --list-syntax-themes` ships only a LIGHT `GitHub`. Rather than pick a
	# wrong-palette approximation for the two surfaces delta still owns,
	# `none` disables syntax highlighting entirely so delta renders with the
	# terminal's own foreground and its plus/minus backgrounds only. Nothing
	# clashes, which matters more here than highlighting does: `add -p` prompts
	# and one lazygit panel are not where code gets read.
	syntax-theme = none
	# Tells delta the terminal background is dark, so it picks line-number and
	# background colors that read against it instead of assuming a light
	# terminal.
	dark = true

# `navigate` and `hyperlinks` are gone with delta's pager role: n/N file
# jumping and OSC 8 clickable paths only ever applied to a full-screen delta
# diff, and hunk covers both natively in the pager slot now.

# ── Hunk difftool ────────────────────────────────────────────────────────────
# `diff.tool` was previously unset — difftastic was reachable only through an
# explicit `-t difftastic`, so this slot was free. Difftool is pair-oriented:
# git invokes the command once per file with temporary paths, which is why
# `hunk diff` remains the better entry point for a whole changeset in one
# stream. This exists for the cases where git itself drives the pairing
# (`git difftool <range>`, `git difftool --staged`).
[diff]
	tool = hunk
[difftool "hunk"]
	cmd = hunk difftool "$LOCAL" "$REMOTE" "$MERGED"
[difftool]
	# Runs straight into the difftool instead of asking "y/n" per file — a
	# `git difftool` invocation is already explicit and deliberate, not one that
	# needs a second confirmation on every file in the range.
	prompt = false

# ── Aliases ──────────────────────────────────────────────────────────────────
[alias]
	# Opens the whole changeset in one hunk stream rather than git's per-file
	# difftool pairing — the review-first path, and the one to reach for when
	# reading more than a couple of files at once.
	review = "!hunk diff"

{{ if .workGitDir }}
[includeIf "gitdir:{{ .workGitDir }}"]
	path = ~/.gitconfig-work
{{ end }}
# Included last, not first: git applies repeated keys in file order, so
# anything ~/.gitconfig.local sets after this point wins over every default
# above — a per-machine override without editing this tracked file.
[include]
	path = ~/.gitconfig.local
