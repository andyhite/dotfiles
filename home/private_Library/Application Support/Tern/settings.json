{
  "theme": "Dark",
  "copy_on_select": true,
  "cursor": {
    "programs": true,
    "glide": 40,
    "trail": "warp",
    "pulse": "ripple"
  },
  "contrast": "Always",
  "layout": "Studio",
  "font_family": "GeistMono Nerd Font",
  "ui_font": "Geist",
  "code_font": "GeistMono Nerd Font",
  "tabs": "Vertical",
  "pane_headers": "Always",
  "status_bar": true,
  "material": "Glass",
  "expand_thoughts": true,
  "prompt_style": "tern",
  "prompt_parts": {
    "frame": "rounded",
    "line_end": true,
    "gap": "dots",
    "dir": "repo",
    "clock": "h12",
    "layout": {
      "left": [
        "os_icon",
        "dir",
        "package",
        "vcs"
      ],
      "right": [
        "status",
        "command_execution_time",
        "background_jobs",
        "node_version",
        "rust_version",
        "swift_version",
        "virtualenv",
        "ram",
        "swap",
        "disk_usage",
        "load",
        "todo"
      ]
    }
  },
  "msaa": "8x",
  "git": {
    "pull_mode": "Rebase",
    "git_executable": "",
    "path_tree": true
  },
  "carly": {
    "model": "@default"
  },
  "keybinds": {
    "ctrl+cmd+enter": "zoom",
    "shift+cmd+[": "previous_tab_across_sessions",
    "shift+cmd+]": "next_tab_across_sessions",
    "shift+cmd+enter": []
  },
  "global_hotkey": "ctrl+enter"
}