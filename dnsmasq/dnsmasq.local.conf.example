# Copied to /opt/homebrew/etc/dnsmasq.local.conf the first time only — a
# re-run of install.sh never overwrites it, so this is the file to add your
# own wildcard-domain records to.
#
# Each line below routes an entire domain (and every subdomain under it) to
# 127.0.0.1, so a local reverse proxy (Caddy, etc.) can terminate TLS for it
# without maintaining one /etc/hosts line per hostname. Pair it with a
# matching /etc/resolver/<domain> file so macOS only sends queries for that
# one domain to dnsmasq — everything else keeps using your normal DNS:
#
#   sudo mkdir -p /etc/resolver
#   sudo tee /etc/resolver/<domain> <<< $'nameserver 127.0.0.1\nport 5453'
#
# address=/.example.internal/127.0.0.1
