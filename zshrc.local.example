# Copy to ~/.zshrc.local (outside the repo — never committed) and fill in
# per-machine secrets and paths. zshrc sources this automatically if it exists,
# after PATH/mise/compinit and before the tool blocks that read these values.
#
# chmod 600 ~/.zshrc.local — it holds credentials.

# ── Secrets ──────────────────────────────────────────────────────────────────
# Model-provider keys are the exception to this file. Put ANTHROPIC_API_KEY and
# OPENAI_API_KEY in ~/.omp/agent/.env instead: this file only reaches processes
# started from a login shell, and on the Linux box the Paseo daemon runs under
# systemd — agents it launches would get no credentials at all.
#
# Setting the variable is also not sufficient on its own. A stored OAuth session
# outranks every environment variable in omp's credential order, so on a machine
# that has run `/login`, the key is ignored until it is pinned in
# ~/.omp/agent/models.yml. See omp/agent/models.yml.example.
# export GITHUB_PERSONAL_ACCESS_TOKEN='github_pat_...'
# export JIRA_API_TOKEN='ATATT...'
# export FIGMA_ACCESS_TOKEN='figd_...'
# export RUNPOD_API_KEY='rpa_...'
# export HF_TOKEN='hf_...'

# ── omp: the machine-local config overlay ────────────────────────────────────
# Turns on ~/.omp/agent/config.local.yml, which install.sh copies but omp reads
# only when this names it. It carries the fallback-chain entries for the
# `anthropic-api` twin, so set this on a machine whose models.yml defines that
# provider and leave it unset everywhere else: every chain entry is validated
# against the live catalog, and a missing provider warns once per role at every
# startup. See omp/agent/config.local.yml.example.
#
# A path list, `:`-separated. Reaches interactive shells and everything they
# spawn, but not a daemon that sources no login shell — a Paseo agent under
# systemd or launchd gets the tracked chains only.
# export PI_CONFIG_FILES="$HOME/.omp/agent/config.local.yml"

# herdr-jira has no *_cmd field for base_url/email/default_project (only the
# token), so those three are placeholders in the tracked config.toml. Point
# this at an untracked directory holding your own config.toml (same [jira]
# shape, real values) to override them — see config_path() in the plugin's
# src/config.rs for the fallback path this replaces.
# export HERDR_PLUGIN_CONFIG_DIR="$HOME/.config/herdr-jira-local"

# ── Work context ─────────────────────────────────────────────────────────────
# export AWS_PROFILE='...'
# export AWS_REGION='us-east-2'

# ── Paseo: which daemon the CLI talks to ─────────────────────────────────────
# `paseo` defaults to localhost:6767, so this is needed on any box where the
# daemon isn't reachable there. That's the obvious case — the Mac, pointing at
# the Linux box — but it's also true *on the daemon box itself* once its
# ~/.config/paseo/daemon.env sets PASEO_LISTEN to a Tailscale address:
# `listen` takes one address, not a list, so binding the tailnet address takes
# the daemon off loopback and its own CLI stops finding it. Same value on both
# machines, then.
#
# CLI only. The desktop app keeps its own list of hosts in app storage, added
# under Settings -> Add host, and nothing here affects it.
#
# PASEO_PASSWORD is the same plaintext value as in the daemon box's
# ~/.config/paseo/daemon.env. Keep it out of PASEO_HOST's query string
# (`?password=...`) — the URI form wins over this variable, but it also lands in
# `ps` output and shell history.
# export PASEO_HOST='linux-box.your-tailnet.ts.net:6767'
# export PASEO_PASSWORD='...'

# ── Machine-specific build flags ─────────────────────────────────────────────
# Each `brew --prefix` is a subprocess on every shell start — only add the
# ones you actually build against.
# export LDFLAGS="-L$(brew --prefix tcl-tk@8)/lib"
# export CPPFLAGS="-I$(brew --prefix tcl-tk@8)/include"
# export PKG_CONFIG_PATH="$(brew --prefix tcl-tk@8)/lib/pkgconfig"

# Apple Silicon: let unimplemented MPS ops fall back to CPU instead of erroring.
# export PYTORCH_ENABLE_MPS_FALLBACK=1
