# Copied by install.sh to ~/.omp/agent/models.yml, beside the config.yml
# symlink, where omp already looks for it. That copy is outside the repo and
# never committed, which is the whole point: config.yml is shared by every
# machine, and this is where a machine says which account pays for it.
#
# Nothing else is per-machine. modelRoles and retry.fallbackChains name built-in
# provider ids — anthropic, openai-codex, openai, cursor — and a machine simply
# skips the ones it cannot authenticate. This file only changes *which
# credential* answers for one of those ids.
#
# It exists because of precedence. omp resolves a credential in a fixed order,
# and a stored OAuth session beats every environment variable:
#
#   1  --api-key (runtime)          5  provider env var, incl. .env files
#   2  models.yml apiKey            6  other stored API key
#   3  stored OAuth credential      7  models.yml custom-provider resolver
#   4  login-sourced stored key
#
# So exporting ANTHROPIC_API_KEY on a box that has ever run `/login anthropic`
# does nothing — the subscription keeps paying, silently, and nothing warns you.
# Tier 2 is the only lever above a stored OAuth session, and it lives here.

providers: {}

# Leave that line as-is on a machine that pays by subscription and overrides
# nothing. It has to stay: omp validates the root as an object, so a file of pure
# comments parses as null and prints, on every single startup:
#
#   Failed to load config file models, Schema error: root: must be an object (was null)


# ── Billing a machine to API keys instead ────────────────────────────────────
# The work box does this. Replace the `providers: {}` above with:
#
# providers:
#   anthropic:
#     auth: none
#     headers:
#       x-api-key: "!sh -c '. \"$HOME/.omp/agent/.env\"; printf %s \"$ANTHROPIC_API_KEY\"'"
#   openai:
#     apiKey: OPENAI_API_KEY
#
# Both are "override-only" entries: no `models` list, so they change auth without
# redeclaring the built-in catalogs, and config.yml needs no change at all.
#
# Anthropic needs the header form. API keys authenticate with `x-api-key`, while
# `Authorization: Bearer` is for OAuth/WIF tokens, and on omp 17.2.13 the
# `apiKey` form produced bearer-auth 401s in fresh interactive sessions where
# print mode succeeded; the internal cause is unconfirmed. `auth: none` skips the
# credential lookup so the explicit header is what authenticates.
#
# The `!` resolver sources the dotenv file itself: command resolvers do not
# inherit values loaded by omp's dotenv loader, so `!printenv ANTHROPIC_API_KEY`
# resolves to nothing for a key that lives only in ~/.omp/agent/.env. OpenAI's
# bare env-var name is fine — that form does go through the dotenv loader. A
# secret store can replace the shell command outright:
#
#   x-api-key: "!op read op://work/anthropic/api-key"
#
# `auth: none` also keeps the provider selectable when the command fails, so
# verify with a live model request rather than trusting `omp models` alone.
#
# The secrets go in ~/.omp/agent/.env, not ~/.zshrc.local: the Paseo daemon runs
# under systemd and sources no login shell, so agents it starts would otherwise
# get no credentials.


# ── Two accounts for one upstream (not used here) ─────────────────────────────
# Pinning replaces, so holding a subscription *and* an API key for Anthropic at
# the same time needs a second provider id carrying its own catalog:
#
# providers:
#   anthropic-api:
#     baseUrl: https://api.anthropic.com
#     api: anthropic-messages
#     auth: none
#     headers:
#       x-api-key: "!sh -c '. \"$HOME/.omp/agent/.env\"; printf %s \"$ANTHROPIC_API_KEY\"'"
#     models:
#       - id: claude-opus-5
#         name: Claude Opus 5 (API account)
#         reasoning: true
#         input: [text, image]
#         contextWindow: 1000000
#         maxTokens: 128000
#
# A provider with its own `models` list is a full custom provider: baseUrl and
# api become required and every model has to be spelled out, since omp will not
# clone a built-in catalog onto a new id.
#
# The catch is routing. Such an id exists only on the machine that defines it,
# and omp validates fallback-chain entries against the catalog, so naming it in
# the tracked config.yml warns once per role on every other machine:
#
#   Warning: Fallback chain for role 'default' references unknown model: anthropic-api/claude-opus-5
#
# A `provider/*` wildcard warns too, as an unknown provider. That is why this
# setup routes through built-in ids only and CI asserts it — an overflow tier is
# not worth making the shared config machine-specific.
