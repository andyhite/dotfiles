# Copied by install.sh to ~/.omp/agent/models.yml, beside the config.yml
# symlink, where omp already looks for it. That copy is outside the repo and
# never committed, which is the whole point: config.yml is shared by every
# machine, and this is where a machine says which account pays for it.
#
# `modelRoles` and `retry.fallbackChains` in the shared config.yml name five
# provider ids across two Anthropic identities, two OpenAI identities, and
# Cursor: `anthropic` (subscription), `openai-codex` (subscription),
# `anthropic-api` (API key), `openai` (API key), `cursor` (subscription).
# A machine simply never resolves the ids it hasn't set up, and omp validates
# every fallback-chain entry against its model catalog, so an unresolvable
# built-in id is skipped without a word — that's the whole mechanism a
# personal box (all five) and a work box (API tiers plus Cursor) need to
# behave differently from one byte-identical config.yml. See "Reducing a
# machine to API tiers only" below for the work-box side of that.
#
# It exists because of precedence. omp resolves a credential in a fixed order,
# and a stored OAuth session beats every environment variable:
#
#   1  --api-key (runtime)          5  provider env var, incl. .env files
#   2  models.yml apiKey            6  other stored API key
#   3  stored OAuth credential      7  models.yml custom-provider resolver
#   4  login-sourced stored key
#
# So exporting ANTHROPIC_API_KEY on a box that has ever run `/login anthropic`
# does nothing for the bare `anthropic` id — the subscription keeps paying,
# silently, and nothing warns you. That's exactly why the API-key tier below
# is a second provider id, not an override of `anthropic` itself.

providers: {}

# Leave that line as-is on a machine that pays every tier by subscription (or
# has none of the API-key tiers set up yet) and overrides nothing. It has to
# stay: omp validates the root as an object, so a file of pure comments parses
# as null and prints, on every single startup:
#
#   Failed to load config file models, Schema error: root: must be an object (was null)


# ── Anthropic's API-key tier: a second provider id ────────────────────────────
# Pinning (below) replaces a built-in id's credential; it can't hold a
# subscription and an API key for the same id at once. Since the fallback
# chain wants both as distinct tiers, the API key gets its own id instead,
# with its own catalog (custom providers don't inherit the built-in one):
#
# providers:
#   anthropic-api:
#     baseUrl: https://api.anthropic.com
#     api: anthropic-messages
#     auth: none
#     headers:
#       x-api-key: "!sh -c '. \"$HOME/.omp/agent/.env\"; printf %s \"$ANTHROPIC_API_KEY\"'"
#     models:
#       - id: claude-opus-5
#         name: Claude Opus 5 (API)
#         reasoning: true
#         input: [text, image]
#         contextWindow: 1000000
#         maxTokens: 128000
#       - id: claude-sonnet-5
#         name: Claude Sonnet 5 (API)
#         reasoning: true
#         input: [text, image]
#         contextWindow: 1000000
#         maxTokens: 128000
#       - id: claude-haiku-4-5
#         name: Claude Haiku 4.5 (API)
#         reasoning: true
#         input: [text, image]
#         contextWindow: 200000
#         maxTokens: 64000
#
# `auth: none` skips the normal credential lookup so the explicit header is
# what authenticates. API keys use `x-api-key`; `Authorization: Bearer` is for
# OAuth/WIF tokens, and on omp 17.2.13 the plain `apiKey` field produced
# bearer-auth 401s in fresh interactive sessions where print mode succeeded —
# the internal cause is unconfirmed, so the header form is deliberate, not
# decorative.
#
# The `!` resolver sources the dotenv file itself: command resolvers do not
# inherit values loaded by omp's own dotenv loader, so `!printenv
# ANTHROPIC_API_KEY` resolves to nothing for a key that lives only in
# ~/.omp/agent/.env. A secret store can replace the shell command outright:
#
#   x-api-key: "!op read op://work/anthropic/api-key"
#
# Reference this id as `anthropic-api/claude-opus-5` etc. It exists only on
# machines that define it, and every machine sharing config.yml is expected
# to (see the Justfile's `templates` check) — an undefined reference warns
# once per role at every startup instead of failing outright.
#
# Verify with a live model request rather than trusting `omp models` alone;
# `auth: none` keeps the provider selectable even when the header command
# fails.


# ── OpenAI's API-key tier: no entry needed ────────────────────────────────────
# The built-in `openai` id already means "API key", separate from the
# subscription `openai-codex` id, so there's nothing to pin here — just
# export OPENAI_API_KEY and the plain env-var credential tier (5, above)
# picks it up, as long as this machine has never run `/login openai`.


# ── Reducing a machine to API tiers only ──────────────────────────────────────
# A machine that should never touch personal subscriptions — a work VM
# billing an employer's API accounts, say — needs no config.yml changes and no
# separate routing. Define `anthropic-api` above, export ANTHROPIC_API_KEY and
# OPENAI_API_KEY in ~/.omp/agent/.env, and simply never run `/login anthropic`
# or `/login openai-codex` on that box. With both subscription ids permanently
# unresolvable there, every role's effective order collapses to
# `anthropic-api -> openai -> cursor` on its own — the two subscription tiers
# were never reachable to begin with, so there's no live failed request behind
# the fallback, just an id the catalog can't resolve.
#
# The secrets go in ~/.omp/agent/.env, not ~/.zshrc.local: omp loads that
# dotenv file itself, so the keys are present no matter how omp is launched,
# while ~/.zshrc.local only reaches login shells. Cursor is unaffected either
# way — it's the one tier both machines are meant to share, so its
# subscription login is set up on both.
