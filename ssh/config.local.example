# Copy to ~/.ssh/config.local (outside the repo — never committed) and fill in
# per-machine hosts. ssh/config Includes this automatically, before its own
# Host blocks, so anything set here wins over the tracked config.
#
# chmod 600 ~/.ssh/config.local — ssh silently ignores config files that are
# group/world-readable/writable.

# A remote dev box reached by short name. The tracked ssh/config carries no
# hostnames of its own, so every machine-specific alias belongs here.
# Host devbox
#   User you

# Throwaway localhost port-forward for testing tmux/moor over ssh instead of
# a real network host. StrictHostKeyChecking/UserKnownHostsFile/LogLevel below
# turn off host-key verification entirely — safe only because the "host" is a
# local process that gets torn down and rebuilt (a new key every time would
# otherwise fail the known_hosts check). Never point these three settings at
# a real remote host.
# Host moor-tmux-test
#   HostName localhost
#   Port 2222
#   User bash
#   IdentityFile ~/.ssh/moor_tmux_test_ed25519
#   IdentitiesOnly yes
#   StrictHostKeyChecking no
#   UserKnownHostsFile /dev/null
#   LogLevel ERROR
