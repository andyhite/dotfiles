# Copied to /opt/homebrew/etc/Caddyfile.local the first time only — a
# re-run of install.sh never overwrites it, so this is the file to add your
# own site blocks to. Imported by the tracked Caddyfile above.
#
# Caddy always runs via `brew services start caddy`, which sets a fixed HOME
# regardless of who starts it — so its default cert-storage location under
# that HOME is stable across restarts and needs no pinning here.
#
# https://frontend.example.internal {
# 	reverse_proxy <tailnet-ip-address>:3000
# }
#
# A wildcard block with a regex matcher covers any `<name>-<port>` hostname
# without a new site block per port — see README's Caddy section:
#
# https://*.example.internal {
# 	@dynport header_regexp p Host ^[a-z0-9]+-(\d+)\.example\.internal$
# 	handle @dynport {
# 		reverse_proxy <tailnet-ip-address>:{re.p.1}
# 	}
# }
