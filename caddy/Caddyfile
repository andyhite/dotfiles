{
	# Local dev tooling wants real HTTPS for internal-only hostnames that
	# Let's Encrypt can never issue for. This mints certs from Caddy's own
	# built-in CA instead — trust it once with `caddy trust`.
	local_certs
}

# Site blocks with real hostnames/IPs are machine-local, never tracked here.
# See Caddyfile.local.example for the template and README's Caddy section
# for the full setup.
import /opt/homebrew/etc/Caddyfile.local
