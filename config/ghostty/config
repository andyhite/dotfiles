theme = One Dark Two

font-family = JetBrainsMono Nerd Font
font-size = 14

shell-integration = detect
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo

window-padding-x = 10
window-padding-y = 10

# Global show/hide used to be bound here (global:ctrl+enter=toggle_visibility),
# but Ghostty's toggle is app-wide, not per-Space, so with one window per
# macOS Space it always jumped to the most-recently-focused window instead of
# showing/hiding the one on the current Space. Hammerspoon owns ctrl+enter
# now — see config/hammerspoon/init.lua and help/00-shell.md's hammerspoon
# section.

# Ghostty's own defaults bind plain Cmd+[ / Cmd+] to goto_split:previous/next.
# `unbind` removes that (rather than rebinding it to something else) so the
# raw chord passes through to whatever's running in the pane — herdr's
# next_workspace/previous_workspace (config/herdr/config.toml) claims it from
# there. Cmd+Shift+[ / Cmd+Shift+] still switch Ghostty's own native tabs;
# only the un-shifted chord moves.
keybind = super+[=unbind
keybind = super+]=unbind
