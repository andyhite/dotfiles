theme = One Dark Two

font-family = GeistMono Nerd Font
font-size = 14

shell-integration = detect
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo

window-padding-x = 10
window-padding-y = 10

# Default discrete (physical mouse wheel) multiplier is 3 lines per click,
# which makes nvim/shells scroll way too far per notch. Trackpad (precision)
# scrolling is already smooth at its default of 1, so only discrete is tuned.
mouse-scroll-multiplier = discrete:1

# Global show/hide used to be bound here (global:ctrl+enter=toggle_visibility),
# but Ghostty's toggle is app-wide, not per-Space, so with one window per
# macOS Space it always jumped to the most-recently-focused window instead of
# showing/hiding the one on the current Space. Hammerspoon owns ctrl+enter
# now — see config/hammerspoon/init.lua and help/00-shell.md's hammerspoon
# section.

# Ghostty's own defaults bind plain Cmd+[ / Cmd+] to goto_split:previous/next,
# and Cmd+Shift+[ / Cmd+Shift+] to native tab switching. `unbind` removes all
# four (rather than rebinding them) so the raw chords pass through to
# whatever's running in the pane — herdr's next_workspace/previous_workspace
# and next_tab/previous_tab (config/herdr/config.toml) claim them from there.
# Native Ghostty tabs go unused here, so surrendering their switcher chord
# costs nothing.
keybind = super+[=unbind
keybind = super+]=unbind
keybind = super+shift+[=unbind
keybind = super+shift+]=unbind
