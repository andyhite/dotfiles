# Collie — mobile web UI for the herd, served over Tailscale.
#
# TEMPLATE. The live file is `.env` beside this one, which is gitignored because
# it can hold VAPID push keys and your tailnet login. Seed it with:
#   cp env.example .env
# then fill in the two values under "Before this is safe to expose" below.
#
# The bridge reads .env ONLY at startup. After any edit:
#   herdr plugin action invoke restart --plugin herdr.collie
#
# On macOS it runs as a launchd LaunchAgent labelled `herdr.collie`, not as a
# herdr pane, so it starts at login and survives herdr restarts. Actions:
# start / stop / restart / status / url / uninstall / update / version.
#
# ── PREREQUISITE ─────────────────────────────────────────────────────────────
# Needs the `tailscale` CLI on PATH. The Mac App Store build hides it inside
# the app bundle, so bin/tailscale in this repo shims it — collie-ctl.sh shells
# out to bare `tailscale` and silently can't publish without it. Building the
# web UI also needs bun.
#
# Starting the bridge is deliberately a manual step:
#   herdr plugin action invoke start --plugin herdr.collie
#   herdr plugin action invoke url   --plugin herdr.collie
#
# NEVER `tailscale funnel` this. Funnel puts it on the public internet; `serve`
# keeps it inside the tailnet. A socket call here can type into a real terminal
# — treat reaching this port as equivalent to shell access.

# ── Network ──────────────────────────────────────────────────────────────────
# Loopback only. `tailscale serve` terminates TLS on the MagicDNS name and
# proxies to this port. Binding 0.0.0.0 would make every identity check below
# meaningless, because they all rest on "the request came from tailscaled".
COLLIE_PORT=8787
COLLIE_HOST=127.0.0.1

# ── Who can reach it ─────────────────────────────────────────────────────────
# Both of these are empty by default, and the bridge warns about each on
# startup. They are the difference between "any device on the tailnet can drive
# every agent" and "only me". Fill both in before starting the bridge.
#
# Your tailnet login (`tailscale status --json | jq -r .Self.UserID` then look
# it up under .User, or just read it off the admin console). Rejects a
# MISMATCHING Tailscale-User-Login and passes an absent one.
# COLLIE_TRUSTED_USER=you@example.com
#
# This machine's MagicDNS name: `tailscale status --json | jq -r .Self.DNSName`.
# Without it Host validation is off and a rebound DNS name can satisfy the
# same-origin check on its own.
# COLLIE_PUBLIC_HOSTS=yourhost.tailnet-name.ts.net

# ── Polling ──────────────────────────────────────────────────────────────────
# Herdr exposes no raw output-stream event, so the bridge polls. Events only
# poke it: while the event stream is healthy the interval relaxes to
# POLL_IDLE_MS, and it drops back to POLL_MS whenever the stream is down. The
# snapshot stays authoritative either way — a missed event costs one interval.
COLLIE_POLL_MS=1500
COLLIE_POLL_IDLE_MS=12000

# Scrollback lines pulled for the detail view.
COLLIE_READ_LINES=200

# Keys sent after the text to submit a reply, comma-separated. Agent-dependent.
COLLIE_SUBMIT_KEYS=Enter

# ── Notifications ────────────────────────────────────────────────────────────
# Debounce before a blocked/done alert reaches your phone. An agent you clear at
# your desk inside this window never pushes at all, and an alert that did fire
# is retracted once the agent resolves. 0 pushes on the next tick.
COLLIE_NOTIFY_DELAY_MS=30000

# Web Push needs a VAPID keypair. Generate with `npx web-push generate-vapid-keys`.
# These are secrets — they belong in .env, never in this template.
# COLLIE_VAPID_PUBLIC=
# COLLIE_VAPID_PRIVATE=
# COLLIE_VAPID_SUBJECT=mailto:you@example.com

# ── Everything else ──────────────────────────────────────────────────────────
# COLLIE_MULTI_SESSION=on   one bridge fronts every named herdr session under
#                           the config root, including sandbox ones. Set 0 to
#                           serve only the primary session.
# COLLIE_TRANSCRIPT=true    read agent journals for scrollback beyond what the
#                           alternate screen keeps. "off" disables wholesale.
# COLLIE_SERVE_MODE=https   "http" for Headscale / .internal domains with no
#                           cert — then COLLIE_PUBLIC_HOSTS is effectively
#                           mandatory, and PWA install plus Web Push stop
#                           working (both need a secure context).
# COLLIE_SKIP_SERVE=1       don't publish via tailscale at all; you own the
#                           ingress (Caddy, nginx, or another mesh). Then set
#                           COLLIE_ALLOWED_ORIGINS and COLLIE_PUBLIC_HOSTS to
#                           your proxy's hostname, and use COLLIE_DEVICE_HEADER
#                           for auth — COLLIE_TRUSTED_USER is inert without
#                           tailscale serve injecting the header.
# COLLIE_DEVICE_HEADER=X-Device-Id + COLLIE_DEVICE_ALLOWLIST=phone,laptop
#                           per-device write gate behind such a proxy. Fails
#                           closed: no header means read-only.
