.DS_Store
# No blanket `*.local` line here on purpose: every real secret lands outside
# this repo, in $HOME, once `chezmoi apply` runs a `create_private_*` file —
# never inside the tracked home/ source tree. A repo-wide `*.local` pattern
# would instead silently swallow four of the six intentionally-tracked
# create_private_*.local seed files the moment any of them is re-added
# (e.g. after a rebase, or a new seed file with the same suffix) — `git
# check-ignore` only looks quiet on them today because it exempts paths
# already in the index, which `git add`/`status` do not.
*.bak.*
**/*.log

# omp takes a lock next to its config while writing it. It's transient (and empty), so it
# shows up as a stray untracked file after any in-app settings change.
home/dot_omp/private_agent/*.lock

