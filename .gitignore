.DS_Store
# No blanket `*.local` line here on purpose: every real secret lands outside
# this repo, in $HOME, once `chezmoi apply` runs a `create_private_*` file —
# never inside the tracked home/ source tree. A repo-wide `*.local` pattern
# would instead silently swallow four of the six intentionally-tracked
# create_private_*.local seed files the moment any of them is re-added
# (e.g. after a rebase, or a new seed file with the same suffix) — `git
# check-ignore` only looks quiet on them today because it exempts paths
# already in the index, which `git add`/`status` do not.
*.bak.*
**/*.log

# linked/herdr-plugin-config is symlinked from ~/.config/herdr/plugins/config,
# so whatever a plugin writes — runtime logs, provider.env with a real
# OPENAI_API_KEY, any credential file under a name nobody predicted — lands
# physically inside this repo. Allowlist form, not a blocklist of known
# secret names: a new plugin's credentials.json or token cache defaults to
# ignored instead of being one `git add -A` away from a commit. Only the
# per-plugin config.toml (and the .gitkeep that keeps the dir) is tracked;
# keep a redacted provider.env.example in the plugin's own repo if a template
# is needed.
linked/herdr-plugin-config/**
!linked/herdr-plugin-config/**/
!linked/herdr-plugin-config/.gitkeep
!linked/herdr-plugin-config/**/config.toml

# omp takes a lock next to its config while writing through the symlink. It's
# transient (and empty), so it shows up as a stray untracked file after any
# in-app settings change.
linked/omp-extensions/*.lock
home/dot_omp/private_agent/*.lock

