#!/usr/bin/env bash
# Renders help/*.md — a curated command reference for every tool this repo
# installs — into stdout, a filtered listing, or an fzf picker with a preview
# pane. `dotfiles-help` is the front door to the whole toolchain: the payoff
# of adding a tool to the Brewfile is nothing until it also has an entry here.
#
# Section format the parser below depends on (see help/*.md):
#
#   ## <name> — <tagline>
#
#   <one or two paragraphs>
#
#       <command>                  # comment
#
#   <optional "Gotcha:" paragraph>
#
# The heading separator is an EM DASH (` — `, not a hyphen), exactly one per
# heading, and nothing else in these files may start a line with `## ` — that
# is what marks the start of the NEXT section. Retitling a heading without
# keeping that shape, or letting some other `## ` line sneak into a body
# paragraph, silently truncates or drops a tool from every mode below, since
# list/search/the picker/name lookup all read the exact same parse (see
# `load_corpus`). `just help-coverage` is the check that catches the other
# half of this: a tool landing in the Brewfile with no matching section here.
set -uo pipefail  # not -e: a picker that dies on one grep/awk miss is a bug,
                   # matches ../config/herdr/palette/palette.sh's reasoning

# ── Self-path resolution ────────────────────────────────────────────────────
#
# This script is symlinked to ~/.local/bin/dotfiles-help by install.sh, so it
# has to find `help/` next to the checkout, not next to the symlink. `readlink
# -f` would do that in one call, but it's a GNU coreutils extension: the BSD
# readlink macOS ships before `brew install coreutils` has no -f, and this
# script has to work on a machine that hasn't been bootstrapped yet. The loop
# below follows the link chain by hand, one hop at a time, resolving each
# relative target against the directory the link itself lives in (never the
# caller's cwd) — that's what `readlink -f`/`realpath` do too.
resolve_self() {
  local path="$1" dir target
  case "$path" in
    */*) : ;; # already has a path component, e.g. invoked as ./bin/dotfiles-help
    *) path="$(command -v -- "$path")" ;; # bare name: ask PATH where the shell found it
  esac
  while [ -L "$path" ]; do
    dir="$(cd "$(dirname "$path")" && pwd)"
    target="$(readlink "$path")"
    case "$target" in
      /*) path="$target" ;;
      *) path="$dir/$target" ;;
    esac
  done
  dir="$(cd "$(dirname "$path")" && pwd)"
  printf '%s/%s\n' "$dir" "$(basename "$path")"
}

self_path="$(resolve_self "$0")"
repo_root="$(cd "$(dirname "$self_path")/.." && pwd)" # bin/dotfiles-help -> repo root

# DOTFILES_HELP_DIR lets a fixture or a relocated checkout override this
# without editing the script — used to develop and test this file against a
# throwaway corpus before help/ existed.
help_dir="${DOTFILES_HELP_DIR:-$repo_root/help}"

die() {
  printf 'dotfiles-help: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
dotfiles-help — search and print the tool reference in help/*.md

Usage
  dotfiles-help                interactive fzf picker with a preview pane
                                (falls back to --list without a tty or fzf)
  dotfiles-help <name>         print one section (exact match, else a
                                case-insensitive substring match on name
                                and tagline)
  dotfiles-help -l, --list     tools grouped by category (A–Z), name A–Z within
  dotfiles-help -a, --all      the whole corpus, in file order
  dotfiles-help -s, --search TEXT
                                case-insensitive search across every
                                section's body; lists matching lines
  dotfiles-help -h, --help     this message

DOTFILES_HELP_DIR overrides where help/ is looked up.
EOF
}

# ── Corpus parsing — the one function every mode reads through ─────────────
#
# awk does the actual parsing (no jq/python dependency); this just streams
# its output back into three parallel bash arrays. Records are separated by a
# literal \036 (RS, ASCII record separator) and each record's header line is
# NAME\037TAGLINE\037SOURCE_FILE (\037, ASCII unit separator) followed by the
# body's lines verbatim — control bytes a tool tagline or command comment
# will never contain, unlike a delimiter such as `|` or a tab.
NAMES=()
TAGLINES=()
BODIES=()
SOURCES=()

load_corpus() {
  [ -d "$help_dir" ] || die "no such directory: $help_dir (set DOTFILES_HELP_DIR, or check the repo layout)"

  local -a files=()
  local f
  for f in "$help_dir"/*.md; do
    [ -e "$f" ] && files+=("$f")
  done
  # An empty help/ is a valid, if useless, corpus — every mode below just
  # reports zero sections rather than erroring, so a fixture missing one
  # numbered file doesn't take the whole command down.
  [ "${#files[@]}" -gt 0 ] || return 0

  local rec header body name tagline
  while IFS= read -r -d $'\036' rec; do
    header="${rec%%$'\n'*}"
    body="${rec#*$'\n'}"
    [ "$body" = "$header" ] && body="" # header had no trailing newline: no body lines
    IFS=$'\037' read -r name tagline source <<<"$header"
    NAMES+=("$name")
    TAGLINES+=("$tagline")
    BODIES+=("$body")
    SOURCES+=("$source")
  done < <(
    # Filenames sort lexically in the order the numeric prefixes intend
    # (00-, 10-, 20-, ...) — that curated order is the point, so nothing
    # here may re-sort by name once parsed.
    awk '
      function emit(   i, start) {
        if (name == "") return
        # The corpus convention is a blank line on each side of the heading
        # (one before the next "## ", one right after this one), but trim
        # any leading/trailing run instead of assuming the count holds, so
        # a section_text() caller can add its own single separator blank
        # line without ever doubling up with one already inside the body.
        start = 1
        while (start <= nbody && body[start] == "") start++
        while (nbody >= start && body[nbody] == "") nbody--
        printf "%s\037%s\037%s\n", name, tagline, file
        for (i = start; i <= nbody; i++) print body[i]
        printf "\036"
      }
      /^## / {
        emit()
        file = FILENAME
        line = $0
        sub(/^## /, "", line)
        # split() takes an ERE for its separator, but an em dash has no
        # regex meaning, so this still matches the literal " — " byte
        # sequence rather than needing manual index() offset arithmetic
        # (which would have to know the byte width of the em dash).
        if (split(line, parts, " — ") == 2) {
          name = parts[1]
          tagline = parts[2]
        } else {
          name = line
          tagline = ""
        }
        nbody = 0
        delete body
        next
      }
      { body[++nbody] = $0 }
      END { emit() }
    ' "${files[@]}"
  )
}

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; } # not ${var,,}: bash 3.2 (macOS's /bin/bash) lacks it

section_text() {
  local i="$1"
  printf '## %s — %s\n\n%s' "${NAMES[i]}" "${TAGLINES[i]}" "${BODIES[i]}"
}

# Pipes through bat/batcat when stdout is a terminal and one is installed, so
# command examples get markdown syntax highlighting; --style=plain drops
# bat's own header/line-number frame so it doesn't double up with the "## "
# heading already in the text. Every other case (piped, redirected, no bat)
# falls straight through to plain text — bat is a nicety, never a dependency.
# Human-readable category from help/NN-name.md (sorted A–Z in --list).
category_label() {
  local f="$1" base
  base="$(basename "$f" .md)"
  base="${base#*-}"
  case "$base" in
    shell) printf 'Shell' ;;
    cli) printf 'CLI' ;;
    git) printf 'Git' ;;
    agents) printf 'Agents' ;;
    dev) printf 'Dev' ;;
    *) printf '%s' "$base" ;;
  esac
}

# Render markdown for humans: glow renders the corpus; bat only highlights
# source when glow is absent. NO_COLOR disables both. -w 0 keeps indented command
# examples from being reflowed away.
render_output() {
  local text="$1" batbin=""
  if [ -z "${NO_COLOR:-}" ] && command -v glow >/dev/null 2>&1; then
    if printf '%s\n' "$text" | glow -s dark -w 0 - 2>/dev/null; then
      return 0
    fi
  fi
  if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    if command -v bat >/dev/null 2>&1; then
      batbin="bat"
    elif command -v batcat >/dev/null 2>&1; then # Debian packages bat as batcat
      batbin="batcat"
    fi
  fi
  if [ -n "$batbin" ]; then
    printf '%s\n' "$text" | "$batbin" --language=markdown --style=plain --paging=never
  else
    printf '%s\n' "$text"
  fi
}

do_list() {
  local i width=0 len cat prev_cat=""
  for ((i = 0; i < ${#NAMES[@]}; i++)); do
    len=${#NAMES[i]}
    [ "$len" -gt "$width" ] && width="$len"
  done
  while IFS=$'\t' read -r cat name tagline; do
    [ -n "$cat" ] || continue
    if [ "$cat" != "$prev_cat" ]; then
      [ -n "$prev_cat" ] && printf '\n'
      printf '%s\n' "$cat"
      prev_cat="$cat"
    fi
    printf '  %-*s  %s\n' "$width" "$name" "$tagline"
  done < <(
    for ((i = 0; i < ${#NAMES[@]}; i++)); do
      printf '%s\t%s\t%s\n' "$(category_label "${SOURCES[i]}")" "${NAMES[i]}" "${TAGLINES[i]}"
    done | sort -t $'\t' -k1,1f -k2,2f
  )
  printf '\n'
}

do_all() {
  local i text=""
  for ((i = 0; i < ${#NAMES[@]}; i++)); do
    [ -n "$text" ] && text+=$'\n\n'
    text+="$(section_text "$i")"
  done
  render_output "$text"
}

do_name() {
  local want="$1" i
  # Exact match wins first, and is a literal string compare (`[[ == ]]` with
  # both sides quoted never treats $want as a glob), so a tool name that
  # happens to contain a character meaningful to `case` or a regex — none do
  # today, but nothing here should break the day one does — still matches
  # itself and only itself.
  for ((i = 0; i < ${#NAMES[@]}; i++)); do
    if [[ "${NAMES[i]}" == "$want" ]]; then
      render_output "$(section_text "$i")"
      return 0
    fi
  done

  # No exact hit: fall back to a case-insensitive substring match against
  # name and tagline together, so "delta" finds git-delta and "find files"
  # finds fd without knowing the exact command. Quoting $needle inside the
  # `*"$needle"*` pattern keeps this a literal substring test too — glob
  # characters typed by the user (e.g. searching for "sd" the stream editor
  # is fine, but a stray "*" shouldn't turn into a wildcard).
  local needle hay
  needle="$(lower "$want")"
  local -a hits=()
  for ((i = 0; i < ${#NAMES[@]}; i++)); do
    hay="$(lower "${NAMES[i]} ${TAGLINES[i]}")"
    [[ "$hay" == *"$needle"* ]] && hits+=("$i")
  done

  case "${#hits[@]}" in
    0)
      printf 'dotfiles-help: no section matches %s\n' "$want" >&2
      return 1
      ;;
    1)
      render_output "$(section_text "${hits[0]}")"
      return 0
      ;;
    *)
      printf 'dotfiles-help: %s is ambiguous, matches:\n' "$want" >&2
      for i in "${hits[@]}"; do
        printf '  %s — %s\n' "${NAMES[i]}" "${TAGLINES[i]}" >&2
      done
      return 1
      ;;
  esac
}

do_search() {
  local needle line hay found=1 i
  needle="$(lower "$1")"
  for ((i = 0; i < ${#NAMES[@]}; i++)); do
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      hay="$(lower "$line")"
      if [[ "$hay" == *"$needle"* ]]; then
        printf '%s: %s\n' "${NAMES[i]}" "$line"
        found=0
      fi
    done <<<"${BODIES[i]}"
  done
  return "$found"
}

do_picker() {
  local i width=0 len rows="" row
  for ((i = 0; i < ${#NAMES[@]}; i++)); do
    len=${#NAMES[i]}
    [ "$len" -gt "$width" ] && width="$len"
  done
  # Field 1 (name, raw) drives selection and the preview callback; field 2
  # is the only thing --with-nth shows, same split palette.sh uses and for
  # the same reason — fzf matches against what's on screen, and the name is
  # already the first thing on screen in field 2, so nothing is unsearchable.
  for ((i = 0; i < ${#NAMES[@]}; i++)); do
    row="$(printf '%s\t%-*s  \033[2m%s\033[22m' "${NAMES[i]}" "$width" "${NAMES[i]}" "${TAGLINES[i]}")"
    rows+="$row"$'\n'
  done

  # The preview pane re-invokes this same script by resolved path, one name
  # at a time, so the preview can never disagree with what `<name>` prints —
  # there's no second rendering path to drift out of sync with the first.
  local preview_cmd
  preview_cmd="$(printf '%q' "$self_path") -- {1}"

  local choice
  choice="$(
    printf '%s' "$rows" \
      | fzf --delimiter=$'\t' \
            --with-nth=2 \
            --ansi \
            --prompt='dotfiles-help ▸ ' \
            --header='↑↓ move · ^d/^u page · enter print · esc cancel' \
            --info=inline \
            --bind='ctrl-d:half-page-down,ctrl-u:half-page-up' \
            --reverse \
            --cycle \
            --no-multi \
            --preview="$preview_cmd" \
            --preview-window='right:60%:wrap'
  )" || true

  [ -n "$choice" ] || return 0 # Esc/Ctrl-C: silent, exit 0
  do_name "${choice%%$'\t'*}"
}

mode="default"
name=""
query=""
while [ $# -gt 0 ]; do
  case "$1" in
    --) shift; mode="name"; name="${1:-}"; shift; break ;;
    -h | --help) mode="help" ;;
    -l | --list) mode="list" ;;
    -a | --all) mode="all" ;;
    -s | --search)
      shift
      case "${1:-}" in
        "" | -*) die "--search needs a value — try --help" ;;
      esac
      mode="search"
      query="$1"
      ;;
    --search=*)
      mode="search"
      query="${1#--search=}"
      [ -n "$query" ] || die "--search needs a value — try --help"
      ;;
    -*) usage >&2; exit 2 ;;
    *) mode="name"; name="$1" ;;
  esac
  shift
done

[ "$mode" = "help" ] && { usage; exit 0; }

# No args: an interactive picker needs a real terminal on both ends (fzf
# reads keystrokes from stdin, draws to stdout) and fzf itself installed.
# Anything less and this degrades to --list, which is what a pipeline or a
# CI log wants anyway.
if [ "$mode" = "default" ]; then
  if [ -t 0 ] && [ -t 1 ] && command -v fzf >/dev/null 2>&1; then
    mode="picker"
  else
    mode="list"
  fi
fi

load_corpus

case "$mode" in
  list) do_list ;;
  all) do_all ;;
  search) do_search "$query" ;;
  name) do_name "$name" ;;
  picker) do_picker ;;
esac
