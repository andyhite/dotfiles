# awk source, run as `awk -f bin/zed-settings-clean` — deliberately NOT an
# executable with a shebang. `#!/usr/bin/env awk -f` works on macOS and fails
# on Linux: BSD kernels split the shebang's arguments, GNU ones pass "awk -f"
# to env as a single string and it dies looking for a program by that name.
# Both call sites (.gitattributes' filter, registered by install.sh, and CI)
# name the interpreter explicitly, so this file never needs an exec bit.
#
# git clean filter for config/zed/settings.json — strips `ssh_connections`
# on the way into the index, leaving the working file untouched.
#
# Zed rewrites ssh_connections every time you connect to or disconnect from a
# remote host, and that file is symlinked out of this repo, so the entries land
# in a tracked file in a public repo without anyone doing anything. They name
# real internal hosts and work project paths. Deleting them once doesn't hold:
# the next connect puts them straight back.
#
# A filter rather than `update-index --skip-worktree`, which was the other
# option: skip-worktree hides *every* change to the file, and the whole reason
# settings.json is tracked is that edits made in Zed's UI show up as diffs here.
# This keeps that and drops only the one key that is machine state.
#
# A filter rather than jq, too. This file is JSONC with `//` comments both in
# its header and interleaved through the body (see the notes on `agent` and on
# the buffer font). jq can't read them, and anything that reformats to get
# around it would rewrite all ~180 lines and throw the comments away. Deleting
# a line range preserves every byte this filter isn't targeting.
#
# git leaves the file alone when the filter is unconfigured, so a clone that
# hasn't run install.sh degrades to today's behaviour rather than erroring.
# install.sh's link_configs registers it per-machine — the path can't be
# committed because the repo lives at a different absolute path on each one.

# Bracket balance for a line, ignoring anything inside a JSON string so a
# bracket in a host name or path can't throw the count off.
function balance(line,   copy, n, i, c) {
  copy = line
  gsub(/\\"/, "", copy)      # escaped quotes first, so they don't close a string
  gsub(/"[^"]*"/, "", copy)  # then whole strings
  n = 0
  for (i = 1; i <= length(copy); i++) {
    c = substr(copy, i, 1)
    if (c == "[" || c == "{") n++
    else if (c == "]" || c == "}") n--
  }
  return n
}

BEGIN { skipping = 0; depth = 0; n = 0 }

# Enter the block. Zed emits it as an array, but count from this line so a
# single-line `"ssh_connections": []` closes immediately and is dropped whole.
!skipping && /^[[:space:]]*"ssh_connections"[[:space:]]*:/ {
  skipping = 1
  depth = balance($0)
  if (depth <= 0) skipping = 0
  next
}

skipping {
  depth += balance($0)
  if (depth <= 0) skipping = 0
  next
}

{ out[n++] = $0 }

# Removing a key can strand the comma that separated it from the one before,
# and `,}` is invalid JSON wherever it appears — so fixing it is always a
# repair, never a change of meaning.
END {
  for (i = 0; i < n; i++) {
    line = out[i]
    if (line ~ /,[[:space:]]*$/) {
      for (j = i + 1; j < n; j++) if (out[j] ~ /[^[:space:]]/) break
      if (j < n && out[j] ~ /^[[:space:]]*[}\]]/) sub(/,[[:space:]]*$/, "", line)
    }
    print line
  }
}
