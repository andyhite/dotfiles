#!/usr/bin/env bash
# fleet — dispatch peer coding agents into herdr worktree workspaces.
#
# The problem this solves: omp's own `task` subagents live inside one omp
# process, so they share its context window, its cwd, and its lifetime. Work
# that wants a real branch, a real checkout, and an agent you can still talk to
# an hour later needs separate omp processes. herdr already has every primitive
# for that (`worktree create`, `agent start/prompt/read/wait`), but stringing
# them together per dispatch is several commands, a JSON dig, and knowing which
# of them yields an agent herdr will actually recognise and address. This is
# that sequence, done once, correctly.
#
# The other half is addressing. Two omp processes cannot see each other —
# `hub`, `history://` and `agent://` are all scoped to a single process — so
# every message between orchestrator and worker rides herdr's agent surface
# instead. `herdr agent prompt <name>` writes into a live agent's input, which
# means the channel is symmetric: a worker answers its orchestrator with the
# same command the orchestrator used to reach it. What each side needs to know
# about the other lives under $FLEET_STATE, keyed by herdr agent name, so
# nothing is written into the repo and no environment has to be injected.
#
# Vocabulary: the ORCHESTRATOR (default handle: the repo root's name) is
# `fleet boss`. A WORKER is an agent `fleet spawn` created. A HANDLE is a herdr
# agent name — `[a-z][a-z0-9_-]{0,31}` — and is the only identifier used here;
# workspace and pane IDs stay inside this script.

set -euo pipefail

FLEET_STATE="${FLEET_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/fleet}"

# Bound on getting a named, input-ready omp into a fresh worktree. `agent
# start` blocks until herdr has detected the agent, so this covers omp's own
# boot; herdr caps its --timeout at 300000 and the value is clamped to that.
SPAWN_TIMEOUT_MS="${FLEET_SPAWN_TIMEOUT_MS:-120000}"
# Bound on a single `fleet ask`/`fleet join`. Long by default: the whole point
# of a worker is that it does something substantial.
WAIT_TIMEOUT_MS="${FLEET_WAIT_TIMEOUT_MS:-3600000}"
# A prompt that never lands is worse than a failed one: `fleet join` then waits
# on an agent that is idle for the wrong reason. herdr already fails fast on a
# stalled prompt; this is the second check, on the state it actually reached.
DISPATCH_SETTLE_MS="${FLEET_DISPATCH_SETTLE_MS:-15000}"
# Commands the `full` layout runs beside the agent. Overridable because they
# are a preference, not a mechanism.
FLEET_EDITOR="${FLEET_EDITOR:-nvim}"
FLEET_GIT_UI="${FLEET_GIT_UI:-lazygit}"
# A new shell may still be loading zsh/mise/direnv when a layout command is
# sent. Verify that the requested TUI actually became foreground and retry.
LAYOUT_START_TIMEOUT_MS="${FLEET_LAYOUT_START_TIMEOUT_MS:-15000}"

die() { printf 'fleet: %s\n' "$*" >&2; exit 1; }
note() { printf '%s\n' "$*" >&2; }

need() { command -v "$1" >/dev/null 2>&1 || die "$1 is required but not on PATH"; }

require_herdr() {
  [ "${HERDR_ENV:-}" = 1 ] || die "not running inside herdr (HERDR_ENV is unset)"
  need herdr
  need jq
}

# herdr prints JSON on stdout and JSON errors on stderr with exit 1. Surfacing
# the raw payload beats a generic failure message every time.
h() {
  local out
  if ! out=$(herdr "$@" 2>&1); then
    die "herdr $* failed: $out"
  fi
  printf '%s' "$out"
}

# ── Handles ──────────────────────────────────────────────────────────────────

# herdr's name grammar is stricter than a branch name, so a branch has to be
# reduced rather than escaped: `feat/1234-add-Widget_v2` -> `feat-1234-add-widget-v2`.
#
# `sed -E` is load-bearing. BSD sed (what macOS ships) does not understand `\+`
# in a basic regex — it matches a literal plus, so the whole substitution
# silently becomes a no-op and the branch name passes through with its slashes
# intact. That produces both an invalid herdr agent name and a worktree path
# with a phantom directory level in it.
slugify() {
  local s
  s=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' \
    | sed -E -e 's/[^a-z0-9]+/-/g' -e 's/^-+//' -e 's/-+$//')
  # A leading digit is legal in a branch and illegal in a herdr agent name.
  case "$s" in [a-z]*) ;; *) s="w-$s" ;; esac
  # Truncating can leave a trailing hyphen, which the grammar also rejects.
  printf '%.32s' "$s" | sed -E -e 's/-+$//'
}

# This pane's own agent handle. Every fleet command a worker runs resolves its
# identity this way, which is why no env var has to be injected at spawn.
self_handle() {
  [ -n "${HERDR_PANE_ID:-}" ] || die "HERDR_PANE_ID is unset; not in a herdr pane"
  h agent list | jq -r --arg p "$HERDR_PANE_ID" \
    '(.result.agents[]? | select(.pane_id == $p) | .name) // empty'
}

agent_field() {
  h agent list | jq -r --arg n "$1" --arg f "$2" \
    '(.result.agents[]? | select(.name == $n) | .[$f]) // empty'
}

agent_exists() { [ -n "$(agent_field "$1" pane_id)" ]; }

# herdr's agent-name grammar: [a-z][a-z0-9_-]{0,31}.
valid_handle() {
  case "$1" in
    [a-z]*) ;;
    *) return 1 ;;
  esac
  case "$1" in *[!a-z0-9_-]*) return 1 ;; esac
  [ ${#1} -le 32 ]
}

# An unused variant of $1, for displacing whoever currently holds it. Clearing
# the holder's name instead would leave a live agent that nothing can address —
# not `fleet send`, not `fleet read`, not even its own `fleet whoami` — so a
# displaced agent is always moved to a name, never anonymized.
free_handle() {
  local base=$1 n=1 candidate
  # Leave room for the "-NN" suffix inside herdr's 32-character limit.
  base=$(printf '%.29s' "$base" | sed -E -e 's/-+$//')
  while [ "$n" -lt 100 ]; do
    candidate="$base-$n"
    if ! agent_exists "$candidate"; then printf '%s' "$candidate"; return 0; fi
    n=$((n + 1))
  done
  return 1
}

# Repo identity for scoping. $FLEET_STATE is machine-global, so without this a
# bare `fleet join` in one repo blocks on another repo's workers and
# `fleet reap --all` deletes their worktrees. The git *common* dir is the key
# rather than the toplevel, so a worktree groups with the repo it came from.
repo_key() {
  local dir=${1:-.} top common
  top=$(cd "$dir" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null) || return 0
  [ -n "$top" ] || return 0
  common=$(cd "$top" && git rev-parse --git-common-dir 2>/dev/null) || return 0
  [ -n "$common" ] || return 0
  ( cd "$top" && cd "$common" && pwd -P )
}

# Whether the enabled workspace-manager plugin declares this repo. This is the
# deterministic coexistence gate: a covered repo belongs to the plugin for as
# long as it is enabled; every other repo belongs to fleet. Letting both race
# and inferring ownership from who started the agent first has an inverse race
# where the loser can still apply its layout afterwards.
workspace_manager_owns_repo() {
  local repo=$1 line config_dir config configured candidate repo_id
  line=$(herdr plugin list 2>/dev/null \
    | sed -n '/^- herdr-plugin-workspace-manager /p')
  case "$line" in *" enabled "*) ;; *) return 1 ;; esac
  config_dir=$(herdr plugin config-dir herdr-plugin-workspace-manager 2>/dev/null) \
    || return 1
  config="$config_dir/config.yml"
  [ -f "$config" ] || return 1
  repo_id=$(repo_key "$repo")

  while IFS= read -r configured; do
    # `repo` accepts a path (including ~) or a bare repo name.
    configured=${configured#"${configured%%[![:space:]]*}"}
    configured=${configured%"${configured##*[![:space:]]}"}
    case "$configured" in
      \"*\") configured=${configured#\"}; configured=${configured%\"} ;;
      \'*\') configured=${configured#\'}; configured=${configured%\'} ;;
    esac
    case "$configured" in
      \~/*) configured="$HOME/${configured#\~/}" ;;
    esac
    case "$configured" in
      */*)
        candidate=$(repo_key "$configured")
        [ -n "$candidate" ] && [ "$candidate" = "$repo_id" ] && return 0
        ;;
      *) [ "$(basename "$repo")" = "$configured" ] && return 0 ;;
    esac
  done < <(sed -E -n 's/^[[:space:]]*-[[:space:]]*repo:[[:space:]]*(.*)$/\1/p' "$config")
  return 1
}

# ── State ────────────────────────────────────────────────────────────────────
#
# One directory per worker under $FLEET_STATE. `meta` is sourced, so values are
# written through printf %q. `report.md` is the worker's deliverable: herdr can
# only scrape a pane's scrollback, and omp runs on the alternate screen where
# scrollback does not survive, so a file is the only reliable transport for a
# report of any length.

meta_dir() { printf '%s/%s' "$FLEET_STATE" "$1"; }
meta_file() { printf '%s/meta' "$(meta_dir "$1")"; }
report_file() { printf '%s/report.md' "$(meta_dir "$1")"; }
# Touched immediately before every dispatch, so a report can be compared
# against it. That is what keeps a follow-up `fleet send` from having to
# truncate the report the worker already filed just to avoid re-reading it.
dispatch_file() { printf '%s/dispatched' "$(meta_dir "$1")"; }

meta_set() {
  local handle=$1; shift
  mkdir -p "$(meta_dir "$handle")"
  local f; f=$(meta_file "$handle")
  : >"$f"
  local kv
  for kv in "$@"; do
    printf '%s=%q\n' "${kv%%=*}" "${kv#*=}" >>"$f"
  done
}

# Rewrite one key, preserving every other line. meta_set() truncates, so using
# it to change a single field means restating all of them — and a field it
# forgot would be silently dropped.
meta_update() {
  local handle=$1 kv=$2
  local key=${kv%%=*} val=${kv#*=}
  local f; f=$(meta_file "$handle")
  [ -f "$f" ] || return 0
  local tmp="$f.tmp" line
  : >"$tmp"
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in "$key="*) continue ;; esac
    printf '%s\n' "$line" >>"$tmp"
  done <"$f"
  printf '%s=%q\n' "$key" "$val" >>"$tmp"
  mv "$tmp" "$f"
}

meta_get() {
  local f; f=$(meta_file "$1")
  [ -f "$f" ] || return 0
  ( set -a; # shellcheck disable=SC1090
    . "$f"; printf '%s' "${!2:-}" )
}

# ── Orchestrator identity ────────────────────────────────────────────────────

# The handle `fleet boss` claims when none is named. A constant default would
# let exactly one repo on the machine ever hold it, since herdr agent names are
# unique across the whole herdr session; the repo root's name gives every
# checkout a default of its own, and still collides — correctly — with a second
# orchestrator in the same one. $FLEET_BOSS_HANDLE overrides.
default_boss() {
  if [ -n "${FLEET_BOSS_HANDLE:-}" ]; then
    printf '%s' "$FLEET_BOSS_HANDLE"; return 0
  fi
  local top
  top=$(git rev-parse --show-toplevel 2>/dev/null) || true
  if [ -n "$top" ]; then slugify "$(basename "$top")"; else printf 'boss'; fi
}

cmd_boss() {
  require_herdr
  local steal=0 name=""
  while [ $# -gt 0 ]; do
    case $1 in
      --steal) steal=1; shift ;;
      -*) die "usage: fleet boss [name] [--steal]" ;;
      *) name=$1; shift ;;
    esac
  done

  local current; current=$(self_handle)
  # With no argument this is a query, not a claim: a pane that already has a
  # handle keeps it.
  if [ -z "$name" ]; then
    if [ -n "$current" ]; then printf '%s\n' "$current"; return 0; fi
    name=$(default_boss)
  fi
  if [ "$current" = "$name" ]; then
    printf '%s\n' "$name"; return 0
  fi
  valid_handle "$name" || die "handle '$name' is not a valid herdr agent name"

  # A name is unique among live agents and follows the pane occupant, so a
  # handle held elsewhere is a live collision, not a stale record. Two repos
  # each wanting a fleet is the ordinary case, so say how to get out of it
  # instead of just refusing.
  local holder; holder=$(agent_field "$name" pane_id)
  if [ -n "$holder" ]; then
    [ "$steal" = 1 ] || die "handle '$name' is held by pane $holder
  use another handle:  fleet boss <name>
  or take it over:     fleet boss $name --steal   (moves $holder aside)"
    local moved
    moved=$(free_handle "$name") \
      || die "cannot free '$name': every variant of it is already in use"
    h agent rename "$holder" "$moved" >/dev/null
    note "fleet: moved the previous '$name' (pane $holder) to '$moved'"
    rebind_boss "$name" "$moved"
  fi
  h agent rename "$HERDR_PANE_ID" "$name" >/dev/null
  # A pane can already be named without ever having been an orchestrator —
  # workspace-manager's layout starts agents as `omp-<workspace>` — so renaming
  # is a normal path, not an error. What is not acceptable is leaving workers
  # pointing at a handle nobody answers to any more: the live agent name is the
  # source of truth, so their records follow it.
  [ -z "$current" ] || rebind_boss "$current" "$name"
  printf '%s\n' "$name"
}

# Repoint every worker that reports to $1 at $2. Deliberately unscoped by repo:
# a handle is unique across the machine, so every record naming it means the
# same agent, wherever its worktree lives.
rebind_boss() {
  local from=$1 to=$2 handle n=0
  [ -n "$from" ] && [ "$from" != "$to" ] || return 0
  for handle in $(known_workers); do
    [ "$(meta_get "$handle" BOSS)" = "$from" ] || continue
    meta_update "$handle" "BOSS=$to"
    n=$((n + 1))
  done
  [ "$n" = 0 ] || note "fleet: repointed $n worker(s) from '$from' to '$to'"
}

cmd_whoami() {
  require_herdr
  local me; me=$(self_handle)
  [ -n "$me" ] || die "this pane has no herdr agent name; run 'fleet boss' first"
  printf '%s\n' "$me"
}

# Resolve who to report to. A worker learns this from its own meta file, which
# `fleet spawn` wrote before the worker existed.
boss_handle() {
  local me; me=$(self_handle)
  local b=""
  [ -n "$me" ] && b=$(meta_get "$me" BOSS)
  printf '%s' "${b:-$(default_boss)}"
}

# ── Spawning ─────────────────────────────────────────────────────────────────

# The protocol block appended to every dispatched task. Workers are ordinary
# omp sessions with no orchestration instructions of their own, so the contract
# has to travel with the work.
protocol_block() {
  local handle=$1 boss=$2 branch=$3 dir=$4
  cat <<EOF

---
## Fleet protocol

You are fleet worker \`$handle\`, working in \`$dir\` on branch \`$branch\`.
Your orchestrator is the agent \`$boss\`.

- Stay inside this worktree. Do not touch other checkouts of this repo.
- Commit your work on this branch when it is done. Do not push and do not open
  a PR unless the task above says to.
- When finished, write your report last:
  \`fleet report -f <file>\` or \`fleet report "<summary>"\`.
  The orchestrator reads that file; terminal output does not reach it.
- If you are blocked or need a decision, run \`fleet reply "<question>"\`. That
  interrupts the orchestrator, so use it for questions, not progress updates.
EOF
}

usage_spawn() {
  cat >&2 <<'EOF'
usage: fleet spawn <branch> [options]

  --base <ref>        branch point (default: the repo's origin HEAD)
  --repo <path>       repo to branch from (default: current repo)
  --path <path>       worktree location (default: sibling <repo>-<slug>)
  --handle <name>     agent handle (default: derived from the branch)
  --layout <shape>    agent (default) | full — see below
  --task <text>       task to dispatch once the agent is ready
  --task-file <path>  read the task from a file ('-' for stdin)
  --no-dispatch       build the worktree, agent, and layout without a task

layouts:
  agent   one pane, running omp. All a worker needs.
  full    omp with an editor beside it, plus shell and review tabs, for a
          worktree you intend to sit in yourself. $FLEET_EDITOR (nvim) and
          $FLEET_GIT_UI (lazygit) choose the commands.
EOF
  exit 2
}

cmd_spawn() {
  require_herdr
  local branch="" base="" repo="" wtpath="" handle="" task="" taskfile="" dispatch=1
  local layout=agent
  [ $# -gt 0 ] || usage_spawn
  branch=$1; shift
  case "$branch" in -*) usage_spawn ;; esac
  while [ $# -gt 0 ]; do
    case $1 in
      --base) base=${2:?}; shift 2 ;;
      --repo) repo=${2:?}; shift 2 ;;
      --path) wtpath=${2:?}; shift 2 ;;
      --handle) handle=${2:?}; shift 2 ;;
      --layout) layout=${2:?}; shift 2 ;;
      --task) task=${2:?}; shift 2 ;;
      --task-file) taskfile=${2:?}; shift 2 ;;
      --no-dispatch) dispatch=0; shift ;;
      *) usage_spawn ;;
    esac
  done

  case "$layout" in
    agent|full) ;;
    *) die "unknown layout '$layout' (expected: agent, full)" ;;
  esac

  repo=${repo:-$(git rev-parse --show-toplevel 2>/dev/null || true)}
  [ -n "$repo" ] || die "not in a git repo and --repo was not given"
  repo=$(cd "$repo" && pwd -P)
  if workspace_manager_owns_repo "$repo"; then
    die "workspace-manager is enabled and configured for $repo
  fleet will not race it or depend on it; remove this repo from:
  $(herdr plugin config-dir herdr-plugin-workspace-manager)/config.yml
  or disable the plugin, then retry"
  fi

  if [ -z "$base" ]; then
    # origin/HEAD is the branch the remote considers default; fall back to
    # whatever is checked out when the symbolic ref was never fetched.
    base=$(git -C "$repo" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)
    base=${base:-$(git -C "$repo" rev-parse --abbrev-ref HEAD)}
  fi

  handle=${handle:-$(slugify "$branch")}
  # Checked before anything is created: a rename that fails after the worktree
  # exists leaves an orphaned workspace with a nameless agent in it, which is
  # exactly the mess this tool exists to avoid.
  valid_handle "$handle" \
    || die "handle '$handle' is not a valid herdr agent name (pass --handle)"
  agent_exists "$handle" && die "handle '$handle' is already in use"

  # The sibling-directory convention, so a worktree is visible next to its repo
  # rather than buried in ~/.herdr/worktrees.
  wtpath=${wtpath:-$(dirname "$repo")/$(basename "$repo")-$(slugify "$branch")}

  if [ -n "$taskfile" ]; then
    if [ "$taskfile" = "-" ]; then task=$(cat); else task=$(cat "$taskfile"); fi
  fi

  # The spawner is the boss, by definition. boss_handle() would be wrong here:
  # it reads the caller's own BOSS record, and only workers have one, so an
  # orchestrator that claimed a custom handle silently stamped the default
  # `boss` into every worker and their replies went to whoever held it.
  local boss; boss=$(self_handle)
  [ -n "$boss" ] || die "this pane has no herdr agent name; run 'fleet boss' first"

  note "fleet: creating $branch at $wtpath (from $base)"
  local created ws tab pane
  created=$(h worktree create --cwd "$repo" --branch "$branch" --base "$base" \
    --path "$wtpath" --no-focus)
  ws=$(printf '%s' "$created" | jq -r '.result.workspace.workspace_id // empty')
  tab=$(printf '%s' "$created" | jq -r '.result.tab.tab_id // empty')
  pane=$(printf '%s' "$created" | jq -r '.result.root_pane.pane_id // empty')
  [ -n "$ws" ] || die "worktree create returned no workspace id"
  [ -n "$tab" ] || die "worktree create returned no root tab id"
  [ -n "$pane" ] || die "worktree create returned no root pane id"

  # Recorded before the agent exists. Every value here is already known, and a
  # spawn that dies further down — no agent could be started, herdr refused a
  # rename — must still leave something `fleet ls` shows and `fleet reap` can
  # remove. Otherwise the failure orphans a worktree no fleet command can see.
  meta_set "$handle" "BOSS=$boss" "BRANCH=$branch" "DIR=$wtpath" "WORKSPACE=$ws" \
    "REPO=$repo" "REPO_KEY=$(repo_key "$repo")"
  : >"$(report_file "$handle")"

  start_worker_agent "$handle" "$ws" "$pane"
  # After the agent, deliberately. The agent is the deliverable; the rest of
  # the layout is scenery, and a worker that works beats a tidy dead workspace.
  apply_layout "$layout" "$ws" "$tab" "$pane" "$wtpath"

  printf '%s\n' "$handle"

  if [ "$dispatch" = 1 ] && [ -n "$task" ]; then
    dispatch_to "$handle" "$task$(protocol_block "$handle" "$boss" "$branch" "$wtpath")"
  fi
}

# Put a named, input-ready omp in the worktree's own pane.
#
# `worktree create` hands back the workspace's root pane, so there is nothing
# to discover: `agent start` launches omp there, takes the name up front, and
# returns only once herdr has detected it and considers it ready for input.
# That one call replaces a poll for `interactive_ready` followed by a rename,
# and it means fleet no longer needs a layout plugin to start an agent.
#
# `agent start` is a loop because it requires the pane to be *at its interactive
# shell prompt*, and a brand-new worktree pane is not — zsh, mise and direnv
# take a few seconds — so early attempts fail fast and are retried. A configured
# workspace-manager is rejected before worktree creation, so this function
# never participates in a layout race with it.
start_worker_agent() {
  local handle=$1 ws=$2 pane=$3
  # herdr caps `agent start --timeout` at 300000.
  local start_ms=$SPAWN_TIMEOUT_MS
  [ "$start_ms" -le 300000 ] || start_ms=300000

  local waited=0 err="" found=""

  while :; do
    if err=$(herdr agent start "$handle" --kind omp --pane "$pane" \
               --timeout "$start_ms" 2>&1); then
      return 0
    fi
    # A failed CLI response can race with the agent it started becoming ready.
    # Recover only if that agent already has the requested handle; a differently
    # named occupant belongs to something else and must never be adopted.
    found=$(workspace_ready_agent "$ws")
    if [ -n "$found" ]; then
      if [ "$(agent_field "$handle" pane_id)" = "$found" ]; then
        note "fleet: the started agent became ready in $found"
        return 0
      fi
      die "workspace $ws already contains an unexpected agent in $found
  fleet will not adopt or rename it
  clean up the worktree with: fleet reap $handle --force"
    fi
    [ "$waited" -lt "$SPAWN_TIMEOUT_MS" ] || break
    sleep 0.5; waited=$((waited + 500))
  done

  die "could not get an agent into workspace $ws within $((SPAWN_TIMEOUT_MS / 1000))s
  agent start said: $err
  clean up the worktree with: fleet reap $handle --force"
}

# The pane id of an input-ready agent in workspace $1, if there is one.
workspace_ready_agent() {
  h agent list | jq -r --arg w "$1" \
    '[ .result.agents[]?
       | select(.workspace_id == $w and .interactive_ready == true)
       | .pane_id ][0] // empty'
}

# Arrange the worktree's workspace from herdr's own primitives, so that
# removing a layout plugin costs a fleet worktree nothing.
#
# `agent` is the default and is the whole job for a worker: the single pane
# `worktree create` returned, running omp. `full` is for a worktree you intend
# to sit in yourself — editor beside the agent, a shell, and a git UI — and is
# the shape worth pairing with `--no-dispatch`.
#
# Panes and tabs are created unfocused: spawning is something an orchestrator
# does in the background, and it must not yank the view out from under whoever
# is reading something else.
apply_layout() {
  local layout=$1 ws=$2 tab=$3 root=$4 dir=$5
  h tab rename "$tab" agent >/dev/null
  h pane rename "$root" omp >/dev/null
  [ "$layout" = full ] || return 0

  local editor shell review created
  editor=$(h pane split "$root" --direction right --ratio 0.45 --cwd "$dir" \
    --no-focus | jq -r '.result.pane.pane_id // empty')
  [ -n "$editor" ] || die "pane split returned no pane id"
  h pane rename "$editor" editor >/dev/null
  run_pane_command "$editor" "$FLEET_EDITOR"

  created=$(h tab create --workspace "$ws" --cwd "$dir" --label shell --no-focus)
  shell=$(printf '%s' "$created" | jq -r '.result.root_pane.pane_id // empty')
  [ -n "$shell" ] || die "tab create returned no shell pane id"
  h pane rename "$shell" shell >/dev/null

  created=$(h tab create --workspace "$ws" --cwd "$dir" --label review --no-focus)
  review=$(printf '%s' "$created" | jq -r '.result.root_pane.pane_id // empty')
  [ -n "$review" ] || die "tab create returned no review pane id"
  h pane rename "$review" review >/dev/null
  run_pane_command "$review" "$FLEET_GIT_UI"
}

# Start a persistent TUI only after the new pane proves its shell can accept
# input. `pane run` is intentionally fire-and-forget; during shell startup it
# can be a successful API call whose input was never consumed.
#
# Retrying nvim/lazygit itself would be unsafe: if the first launch were merely
# slow, the retry would land inside the TUI as keystrokes. Instead retry only a
# harmless printf sentinel. Seeing that exact marker acknowledges the shell;
# the real command is then sent exactly once and only observed. Optional layout
# tools stay optional: if the pane's own shell cannot resolve one, its tab is
# left as a useful shell and spawn says why.
run_pane_command() {
  local pane=$1 command=$2
  local executable=${command%% *}
  executable=$(basename "$executable")
  wait_shell_ready "$pane"
  if ! pane_has_command "$pane" "$executable"; then
    note "fleet: '$executable' is unavailable in $pane; leaving it as a shell"
    return 0
  fi
  h pane run "$pane" "$command" >/dev/null

  local waited=0
  while [ "$waited" -lt "$LAYOUT_START_TIMEOUT_MS" ]; do
    if pane_runs "$pane" "$executable"; then return 0; fi
    sleep 0.25; waited=$((waited + 250))
  done
  die "'$command' did not start in pane $pane within $((LAYOUT_START_TIMEOUT_MS / 1000))s"
}

pane_has_command() {
  local pane=$1 executable=$2 id=${1//[:]/_} quoted result line
  printf -v quoted '%q' "$executable"
  local available="__fleet_command_available_${id}__"
  local missing="__fleet_command_missing_${id}__"
  # The full marker is not present in this input line: `%s` is filled only
  # during execution. wait-output therefore cannot mistake terminal echo for
  # the command's result.
  h pane run "$pane" \
    "if command -v $quoted >/dev/null 2>&1; then state=available; else state=missing; fi; printf '__fleet_command_%s_${id}__\\n' \"\$state\"" \
    >/dev/null
  result=$(herdr pane wait-output "$pane" \
    --regex "__fleet_command_(available|missing)_${id}__" \
    --source recent-unwrapped --lines 20 --timeout "$LAYOUT_START_TIMEOUT_MS" 2>&1) \
    || die "pane $pane did not answer the command-availability check: $result"
  line=$(printf '%s' "$result" | jq -r '.result.matched_line // empty')
  case "$line" in *"$available"*) return 0 ;; *"$missing"*) return 1 ;;
    *) die "pane $pane returned an invalid command-availability result: $line" ;; esac
}

wait_shell_ready() {
  local pane=$1 id=${1//[:]/_}
  local marker="__fleet_shell_ready_${id}__"
  local waited=0
  while [ "$waited" -lt "$LAYOUT_START_TIMEOUT_MS" ]; do
    # The full marker is assembled by printf, so terminal echo cannot satisfy
    # the wait. Repetition is harmless; marker output is the acknowledgement.
    h pane run "$pane" "printf '__fleet_shell_%s_${id}__\\n' ready" >/dev/null
    if herdr pane wait-output "$pane" --match "$marker" \
         --source recent-unwrapped --lines 20 --timeout 1000 >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.25; waited=$((waited + 1250))
  done
  die "pane $pane did not reach an interactive shell prompt within $((LAYOUT_START_TIMEOUT_MS / 1000))s"
}

pane_runs() {
  herdr pane process-info --pane "$1" 2>/dev/null \
    | jq -e --arg executable "$2" '
        any(.result.process_info.foreground_processes[]?;
            .name == $executable
            or ((.argv0 // "") | split("/")[-1] == $executable))' \
      >/dev/null
}

# ── Dispatch ─────────────────────────────────────────────────────────────────

# Submit and confirm the agent actually picked it up. herdr fails a stalled
# prompt on its own, but "prompt accepted" is not "prompt started": without
# this settle loop a following `fleet join` can match the agent's
# *pre-dispatch* idle state and return instantly. Failing closed here is the
# point — a spawn that reports success on a prompt that never ran is worse
# than one that dies. The worktree and meta already exist at that point, so
# `fleet read` and `fleet reap` still work on it.
dispatch_to() {
  local handle=$1 text=$2
  local rf df; rf=$(report_file "$handle"); df=$(dispatch_file "$handle")
  mkdir -p "$(meta_dir "$handle")"
  : >"$df"
  h agent prompt "$handle" "$text" >/dev/null
  local waited=0 status=""
  while [ "$waited" -lt "$DISPATCH_SETTLE_MS" ]; do
    status=$(agent_field "$handle" agent_status)
    case "$status" in
      working|blocked) return 0 ;;
      # A task small enough to finish inside the settle window still counts,
      # but only on the evidence of a report written after the dispatch.
      idle|done) if [ -s "$rf" ] && [ "$rf" -nt "$df" ]; then return 0; fi ;;
    esac
    sleep 0.5; waited=$((waited + 500))
  done
  die "$handle did not pick up the prompt within $((DISPATCH_SETTLE_MS / 1000))s (status: ${status:-gone})
  inspect it with: fleet read $handle"
}

with_protocol() {
  local handle=$1 text=$2
  printf '%s%s' "$text" \
    "$(protocol_block "$handle" "$(meta_get "$handle" BOSS)" \
       "$(meta_get "$handle" BRANCH)" "$(meta_get "$handle" DIR)")"
}

cmd_send() {
  require_herdr
  local handle=${1:?usage: fleet send <handle> <text...>}; shift
  agent_exists "$handle" || die "no live agent named '$handle'"
  local text="$*"
  [ -n "$text" ] || text=$(cat)
  dispatch_to "$handle" "$(with_protocol "$handle" "$text")"
}

cmd_ask() {
  require_herdr
  local handle=${1:?usage: fleet ask <handle> <text...>}; shift
  cmd_send "$handle" "$@"
  cmd_join "$handle"
}

# Block until each worker settles, then print what it wrote. `herdr agent wait`
# matches idle/done/blocked; `blocked` means the agent is sitting on an approval
# or a question, which is a result worth reporting rather than waiting through.
cmd_join() {
  require_herdr
  # Built as a string, not an array: bash 3.2 (what ships on macOS) treats
  # ${#arr[@]} on an empty array as an unbound-variable error under `set -u`,
  # and handles are whitespace-free by construction.
  local handles="$*" scope
  if [ -z "$handles" ]; then
    scope=$(scoped_key "fleet join" "run it from inside a repo, or name the handles to join")
    handles=$(live_workers "$scope")
  fi
  [ -n "$handles" ] || die "no workers to join"

  local handle status rf df
  for handle in $handles; do
    h agent wait "$handle" --timeout "$WAIT_TIMEOUT_MS" >/dev/null
    status=$(agent_field "$handle" agent_status)
    rf=$(report_file "$handle"); df=$(dispatch_file "$handle")
    printf '\n=== %s (%s) — branch %s\n' "$handle" "$status" "$(meta_get "$handle" BRANCH)"
    if [ -s "$rf" ] && { [ ! -e "$df" ] || [ "$rf" -nt "$df" ]; }; then
      cat "$rf"
    elif [ "$status" = blocked ]; then
      printf '(blocked, nothing reported since the last dispatch — last output below)\n'
      h agent read "$handle" --source recent-unwrapped --lines 40
    elif [ -s "$rf" ]; then
      # Stale, but kept: a follow-up `fleet send` must not destroy the report a
      # worker already filed, so staleness is dated rather than deleted.
      printf '(nothing reported since the last dispatch; previous report follows)\n'
      cat "$rf"
    else
      printf '(no report written; check with: fleet read %s)\n' "$handle"
    fi
  done
}

cmd_read() {
  require_herdr
  local handle=${1:?usage: fleet read <handle> [-n lines]}; shift
  local lines=120
  [ "${1:-}" = "-n" ] && { lines=${2:?}; shift 2; }
  h agent read "$handle" --source recent-unwrapped --lines "$lines"
}

# ── Worker side ──────────────────────────────────────────────────────────────

cmd_report() {
  require_herdr
  local me; me=$(self_handle)
  [ -n "$me" ] || die "this pane is not a named fleet worker"
  local rf; rf=$(report_file "$me")
  mkdir -p "$(dirname "$rf")"
  if [ "${1:-}" = "-f" ]; then
    cp "${2:?}" "$rf"
  elif [ $# -gt 0 ]; then
    printf '%s\n' "$*" >"$rf"
  else
    cat >"$rf"
  fi
  printf 'reported %s bytes to %s\n' "$(wc -c <"$rf" | tr -d ' ')" "$me"
}

cmd_reply() {
  require_herdr
  local me boss; me=$(self_handle); boss=$(boss_handle)
  agent_exists "$boss" || die "orchestrator '$boss' is not live"
  local text="$*"
  [ -n "$text" ] || text=$(cat)
  h agent prompt "$boss" "[fleet:${me:-unknown}] $text" >/dev/null
  printf 'sent to %s\n' "$boss"
}

# ── Inventory and teardown ───────────────────────────────────────────────────

# Whitespace-separated handles for every registered worker, scoped to one repo
# key. An empty scope means every repo on the machine and is reachable only
# through an explicit --all-repos; every default path goes through
# scoped_key(). `true` at the end because a filtered-out or non-live final
# entry would otherwise leave the function non-zero and trip `set -e` at the
# caller's assignment.
known_workers() {
  local scope=${1-} d handle
  for d in "$FLEET_STATE"/*/; do
    [ -d "$d" ] || continue
    handle=$(basename "$d")
    [ -z "$scope" ] || [ "$(meta_get "$handle" REPO_KEY)" = "$scope" ] || continue
    printf '%s\n' "$handle"
  done
  true
}

live_workers() {
  local handle
  for handle in $(known_workers "${1-}"); do
    if agent_exists "$handle"; then printf '%s\n' "$handle"; fi
  done
  true
}

# The repo key a default-scoped command must run under. Failing closed is the
# whole point: outside a repo the key is empty, and an empty key would widen
# `join`, `ls` and `reap --all` back to every repo on the machine — the exact
# machine-global behaviour scoping exists to prevent.
scoped_key() {
  local key; key=$(repo_key)
  [ -n "$key" ] || die "not in a git repo, so '$1' has nothing to scope to
  $2"
  printf '%s' "$key"
}

cmd_ls() {
  require_herdr
  local scope=""
  if [ "${1:-}" != "--all-repos" ]; then
    scope=$(scoped_key "fleet ls" "run it from inside a repo, or pass --all-repos")
  fi
  local handle status
  printf '%-20s %-9s %-28s %s\n' HANDLE STATUS BRANCH DIR
  for handle in $(known_workers "$scope"); do
    status=$(agent_field "$handle" agent_status)
    [ -n "$status" ] || status=gone
    printf '%-20s %-9s %-28s %s\n' "$handle" "$status" \
      "$(meta_get "$handle" BRANCH)" "$(meta_get "$handle" DIR)"
  done
}

cmd_reap() {
  require_herdr
  local force=0 handles="" scope
  while [ $# -gt 0 ]; do
    case $1 in
      --force) force=1; shift ;;
      --all)
        scope=$(scoped_key "fleet reap --all" "pass --all-repos, or name the handles to reap")
        handles="$handles $(known_workers "$scope")"; shift ;;
      --all-repos) handles="$handles $(known_workers)"; shift ;;
      *) handles="$handles $1"; shift ;;
    esac
  done
  [ -n "${handles// /}" ] || die "usage: fleet reap <handle>... | --all [--all-repos] [--force]"

  local handle ws
  local -a args
  for handle in $handles; do
    ws=$(meta_get "$handle" WORKSPACE)
    if [ -n "$ws" ]; then
      args=(worktree remove --workspace "$ws")
      [ "$force" = 1 ] && args+=(--force)
      # A worker with uncommitted work makes herdr refuse; that refusal is the
      # safety net, so it is reported and skipped rather than forced silently.
      if herdr "${args[@]}" >/dev/null 2>&1; then
        note "fleet: removed $handle ($(meta_get "$handle" BRANCH))"
      else
        note "fleet: could not remove $handle — uncommitted changes? retry with --force"
        continue
      fi
    fi
    rm -rf "${FLEET_STATE:?}/$handle"
  done
}

# ── Entry point ──────────────────────────────────────────────────────────────

usage() {
  cat >&2 <<'EOF'
fleet — dispatch peer coding agents into herdr worktree workspaces

Orchestrator
  fleet boss [name] [--steal]    claim the orchestrator handle for this pane
  fleet spawn <branch> [opts]    create a worktree, start an agent, dispatch
  fleet send <handle> <text>     dispatch work, return immediately
  fleet ask <handle> <text>      dispatch and block until the report is in
  fleet join [handle...]         block on this repo's workers, print reports
  fleet ls [--all-repos]         list workers and their states
  fleet read <handle> [-n N]     read a worker's terminal directly
  fleet reap <handle>|--all      remove worktrees and forget workers

Worker
  fleet report [-f file|text]    write the report the orchestrator collects
  fleet reply <text>             interrupt the orchestrator with a question
  fleet whoami                   print this pane's handle

`fleet spawn --help` lists spawn options.
EOF
  exit 2
}

main() {
  [ $# -gt 0 ] || usage
  local cmd=$1; shift
  case "$cmd" in
    boss)    cmd_boss "$@" ;;
    whoami)  cmd_whoami "$@" ;;
    spawn)   [ "${1:-}" = "--help" ] && usage_spawn; cmd_spawn "$@" ;;
    send)    cmd_send "$@" ;;
    ask)     cmd_ask "$@" ;;
    join)    cmd_join "$@" ;;
    read)    cmd_read "$@" ;;
    report)  cmd_report "$@" ;;
    reply)   cmd_reply "$@" ;;
    ls|list) cmd_ls "$@" ;;
    reap)    cmd_reap "$@" ;;
    -h|--help|help) usage ;;
    *) die "unknown command '$cmd' (try: fleet --help)" ;;
  esac
}

main "$@"
